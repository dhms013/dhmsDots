alias ls='eza -lh --group-directories-first --icons=auto'
alias lsa='ls -a'
alias lt='eza --tree --level=3 --long --icons --git'
alias lta='lt -a'
alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'
alias waybar="systemctl --user restart waybar.service"
alias fetch="clear; ~/.config/fastfetch/ffetch_wrapper.sh"
alias pkgs="expac --timefmt='%Y-%m-%d %T' '%l\t%n' | sort | tail -n 20"
alias icat="clear; kitty +kitten icat"
alias megumin="icat ~/.config/fastfetch/logo/megumin.gif"
alias lv='nvim $(fzf -m --preview="bat --color=always {}")'
alias lg='lazygit'
alias bashrc="clear; source ~/.bashrc"
alias gadd="git add"
alias gcm="git commit -m"
alias gco="git checkout"
alias gclone="git clone"
alias gs="git switch -c"
alias gp="git push"
alias gpull="git pull"
alias gm="git merge"
alias gstat="git status"
alias mainasrock="gco main ; gm origin/asrock ; gp ; gco asrock"
alias mainthinkpad="gco main ; gm origin/thinkpad ; gp ; gco thinkpad"
alias boo="ghostty +boo"
alias t='tmux attach || tmux new -s dhms'
n() { if [ "$#" -eq 0 ]; then command nvim . ; else command nvim "$@"; fi; }
alias c='opencode'
alias cx='printf "\033[2J\033[3J\033[H" && claude --allow-dangerously-skip-permissions'
alias relog="hyprctl dispatch exit"
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias anime="ani-cli"
