gpr() {
    if [ -z "$1" ]; then
      REMOTE_BRANCH=$(gum input --placeholder="Enter remote branch" --header="")
    else
      REMOTE_BRANCH="$1"
    fi
    if [ -z "$2" ]; then
      TARGET_BRANCH=$(gum input --placeholder="Enter target branch" --header="")
    else
      TARGET_BRANCH="$2"
    fi
    if [ -z "$REMOTE_BRANCH" ] || [ -z "$TARGET_BRANCH" ]; then
      echo "Error: No remote branch and/or target branch provided"
      echo "Usage: gpr <remote-branch> <target-branch>"
      return 1
    fi
    git pull --rebase "$REMOTE_BRANCH" "$TARGET_BRANCH" && gp
  }

gcp() {
  if [ -z "$1" ]; then
    COMMIT_MSSG=$(gum input --placeholder="Enter commit message" --header="")
  else
    COMMIT_MSSG="$1"
  fi
  if [ -z "$COMMIT_MSSG" ]; then
    echo "Error: No commit message provided."
    return 1
  fi
  echo "Adding all files, committing with message: \"$1\", and pushing..."
  gadd . && gcm "$COMMIT_MSSG" && gp
}

gcpa() {
  if [ -z "$1" ]; then
    COMMIT_MSSG=$(gum input --placeholder="Enter commit message" --header="")
  else
    COMMIT_MSSG="$1"
  fi
  if [ -z "$COMMIT_MSSG" ]; then
    echo "Error: No commit message provided."
    return 1
  fi
  echo "Run chainned git actions..."
  gadd . && gcm "$COMMIT_MSSG" && gp && gco main && gm origin/asrock && gp && gco asrock
}

