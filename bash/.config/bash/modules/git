gpr() {
    local CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    local REMOTE_BRANCH=$(git config --get "branch.$CURRENT_BRANCH.remote")

    if [ -z "$1" ]; then
      TARGET_BRANCH=$(gum input --placeholder="Enter target branch" --header="Remote = $REMOTE_BRANCH")
    else
      TARGET_BRANCH="$1"
    fi

    if [ -z "$TARGET_BRANCH" ]; then
      echo "Error: No target branch provided"
      echo "Usage: gpr <target-branch>"
      return 1
    fi

    git pull --rebase "$REMOTE_BRANCH" "$TARGET_BRANCH" && gp
  }

gcp() {
  if [ -z "$1" ]; then
    COMMIT_MSSG=$(gum input --placeholder="Enter commit message" --header="")
  else
    COMMIT_MSSG="$1"
  fi
  if [ -z "$COMMIT_MSSG" ]; then
    echo "Error: No commit message provided."
    return 1
  fi
  echo "Adding all files, committing with message: \"$1\", and pushing..."
  gadd . && gcm "$COMMIT_MSSG" && gp
}

gcpa() {
  if [ -z "$1" ]; then
    COMMIT_MSSG=$(gum input --placeholder="Enter commit message" --header="")
  else
    COMMIT_MSSG="$1"
  fi
  if [ -z "$COMMIT_MSSG" ]; then
    echo "Error: No commit message provided."
    return 1
  fi
  echo "Run chainned git actions..."
  gadd . && gcm "$COMMIT_MSSG" && gp && gco main && gm origin/asrock && gp && gco asrock
}

