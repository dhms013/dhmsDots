{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "margin-top": 1,
  "height": 10,
  "margin-bottom": 2,
  "modules-left": [],

  //"modules-center": ["hyprland/window"],
  "modules-center": [
    "mpris",
    "hyprland/workspaces",
    "custom/updatespacman",
    "custom/update",
    "custom/screenrecording-indicator",
    "tray",
    "idle_inhibitor",
    "group/tray-expander",
  ],

  //"modules-right": ["group/group-power"],
  "modules-right": [],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "warp-on-scroll": false,
    "sort-by-number": true,
    "show-special": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "format": "{windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "&#9201;",
    "window-rewrite": {
      "title<.*amazon.*>": "&#61734;",
      "class<firefox|org.mozilla.firefox|librewolf|floorp|mercury-browser|[Cc]achy-browser>": "&#63867;",
      "class<zen>": "&#63799;",
      "class<waterfox|waterfox-bin>": "&#63723;",
      "class<microsoft-edge>": "&#61698;",
      "class<Chromium|Thorium|[Cc]hrome>": "&#61864;",
      "class<brave-browser>": "&#129408;",
      "class<tor browser>": "&#63769;",
      "class<firefox-developer-edition>": "&#129393;",
      "class<kitty|konsole>": "&#63997;",
      "class<kitty-dropterm>": "&#61696;",
      "class<com.mitchellh.ghostty>": "&#61709;",
      "class<org.wezfurlong.wezterm>": "&#61701;",
      "class<[Tt]hunderbird|[Tt]hunderbird-esr>": "&#63760;",
      "class<eu.betterbird.Betterbird>": "&#63760;",
      "title<.*gmail.*>": "&#61899;",
      "class<[Tt]elegram-desktop|org.telegram.desktop|io.github.tdesktop_x64.TDesktop>": "&#63415;",
      "class<discord|[Ww]ebcord|Vesktop>": "&#61887;",
      "title<.*whatsapp.*>": "&#63762;",
      "title<.*zapzap.*>": "&#63762;",
      "title<.*messenger.*>": "&#61983;",
      "title<.*facebook.*>": "&#62253; ",
      "title<.*reddit.*>": "&#62257;",
      "class<.*reddit.*>": "&#62257;",
      "title<.*ChatGPT.*>": "&#61833;",
      "class<.*ChatGPT.*>": "&#61833;",
      "title<.*deepseek.*>": "&#61833;",
      "title<.*qwen.*>": "&#61833;",
      "class<subl>": "&#61797;",
      "class<slack>": "&#63832;",
      "class<mpv>": "&#63864;",
      "class<celluloid|Zoom>": "&#61853;",
      "class<Cider>": "&#61430; ",
      "title<.*Picture-in-Picture.*>": "&#63732;",
      "title<.*youtube.*>": "&#61974;",
      "class<vlc>": "&#61452;",
      "title<.*cmus.*>": "&#61441;",
      "class<[Ss]potify>": "&#61882;",
      "class<virt-macodeger>": "&#63227;",
      "class<.virt-manager-wrapped>": "&#63227;",
      "class<virtualbox manager>": "&#128451;",
      "title<virtualbox>": "&#128451;",
      "class<remmina>": "&#63744;",
      "class<VSCode|code-url-handler|code-oss|codium|codium-url-handler|VSCodium>": "&#61822;",
      "class<dev.zed.Zed>": "&#63769;",
      "class<codeblocks>": "&#61769;",
      "title<.*github.*>": "&#61827;",
      "class<mousepad>": "&#63739; ",
      "class<libreoffice-writer>": "&#62165; ",
      "class<libreoffice-startcenter>": " &#61446;",
      "class<libreoffice-calc>": "&#63835;",
      "title<.*nvim ~.*>": "&#63831;",
      "class<org.gnome.Nautilus>": "&#62998;",
      "title<.*vim.*>": "&#62765;",
      "title<.*figma.*>": "&#63255;",
      "title<.*jira.*>": "&#63260;",
      "class<jetbrains-idea>": "&#62837;",
      "title<*.VSCode.*>": "&#61822;",
      "class<.*code.*>": "&#61822;",
      "class<obs|com.obsproject.Studio>": "&#62917;",
      "class<polkit-gnome-authentication-agent-1>": "&#61635;",
      "class<nwg-look>": "&#63258;",
      "class<[Pp]avucontrol|org.pulseaudio.pavucontrol>": "&#61882;",
      "class<steam>": "&#63830;",
      "class<thunar|nemo>": "&#62998;",
      "class<Gparted>": "&#62919;",
      "class<gimp>": "&#63800;",
      "class<emulator>": "&#128241;",
      "class<android-studio>": "&#63835;",
      "class<org.pipewire.Helvum>": "&#61444;",
      "class<localsend>": "&#63752;",
      "class<PrusaSlicer|UltiMaker-Cura|OrcaSlicer>": "&#62971;",
      "title<.*instagram.*>": "&#63773;",
      "title<.*plex.*>": "&#61850;",
      "title<.*karakeep.*>": "&#61440;",
      "title<.*homepage.*>": "&#61595;",
      "title<.*freshrss.*>": "&#61675;",
      "title<World Of Warcraft>": "&#62966;",
      "title<.*messages.*>": "&#61445;",
      "title<.*music.youtube.*>": "&#61482;",
      "class<.*chrome-music.youtube.*>": "&#61482;",
    },
  },
  "custom/update": {
    "format": "&#61461;",
    "exec": "omarchy-update-available",
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
    "tooltip-format": "Omarchy update available",
    "signal": 7,
    "interval": 21600,
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "&#61940;",
      "deactivated": "&#62165;",
    },
  },
  "custom/voxtype": {
    "exec": "omarchy-voxtype-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "&#63788;",
      "transcribing": "&#61615;",
    },
    "tooltip": true,
    "on-click-right": "omarchy-voxtype-config",
  },
  "custom/updatespacman": {
    "format": "{}{icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": " &#61562;",
      "updated": "",
    },
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --no-zero-output",
  },
  "cpu": {
    "interval": 5,
    "format": "{usage}% &#61483;",
    "tooltip": true,
    "tooltip-format": "CPU Usage: {usage}%",
    "on-click": "omarchy-launch-or-focus-tui btop",
    "on-click-right": "alacritty"
  },
  "memory": {
    "interval": 30,
    "format": "{used:0.1f}GiB &#63014;",
    "on-click": "omarchy-launch-or-focus-tui btop",
    "tooltip-format": "TOTAL: {total:0.1f}GiB \nSWAP: {swapUsed:0.1f}GiB ({swapPercentage}%)",
  },

  "custom/voxtype": {
    "exec": "omarchy-voxtype-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "&#63788;",
      "transcribing": "&#61615;",
    },
    "tooltip": true,
    "on-click-right": "omarchy-voxtype-config",
    "on-click": "omarchy-voxtype-model",
  },
  "mpris": {
    "format": "{player_icon}",
    "format-paused": "<span color='grey'>{status_icon}</span>",
    "max-length": 50,
    "interval": 1,
    "player-icons": {
      "default": "&#61488;",
      "mpv": "&#61488;",
    },
    "status-icons": {
      "paused": "&#61460;",
    },
    "ignored-players": ["firefox", "brave"],
  },
  "custom/screenrecording-indicator": {
    "on-click": "omarchy-cmd-screenrecord",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json",
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item",
    },
    "modules": ["custom/expand-icon", "memory", "cpu"],
  },
  "custom/expand-icon": {
    "format": "&#62964; ",
    "tooltip": false,
  },
  "tray": {
    "icon-size": 12,
    "spacing": 5,
    "show-passive-items": true,
  },
}
