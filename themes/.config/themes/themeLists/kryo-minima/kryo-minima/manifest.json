{
    "manifest_version": 2,
    "version": "1.11",
    "name": "kryo minima",
    "short_name": "minima",
    "description": "A minimal dark theme for Firefox",
    "icons": {
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "hi@kryo.dev",
            "strict_min_version": "109.0"
        }
    },
    "theme": {
        "colors": {
            "bookmark_text": "rgb(212, 212, 212)",
            "button_background_active": "rgb(120, 0, 48)",
            "button_background_hover": "rgb(160, 0, 64)",
            "focus_outline": "rgb(200, 0, 80)",
            "frame": "rgb(17, 18, 20)",
            "frame_inactive": "rgb(17, 18, 20)",
            "icons": "rgb(212, 212, 212)",
            "icons_attention": "rgb(200, 0, 80)",
            "ntp_background": "rgb(24, 26, 29)",
            "ntp_card_background": "rgb(31, 34, 38)",
            "ntp_text": "rgb(212, 212, 212)",
            "popup": "rgb(24, 26, 29)",
            "popup_border": "rgb(38, 41, 47)",
            "popup_highlight": "rgb(120, 0, 48)",
            "popup_highlight_text": "rgb(255, 255, 255)",
            "popup_text": "rgb(212, 212, 212)",
            "sidebar": "rgb(24, 26, 29)",
            "sidebar_border": "rgb(38, 41, 47)",
            "sidebar_highlight": "rgb(120, 0, 48)",
            "sidebar_highlight_text": "rgb(255, 255, 255)",
            "sidebar_text": "rgb(212, 212, 212)",
            "tab_background_separator": "rgb(38, 41, 47)",
            "tab_background_text": "rgb(212, 212, 212)",
            "tab_hover": "rgb(24, 26, 29)",
            "tab_loading": "rgb(160, 0, 64)",
            "tab_selected": "rgb(160, 0, 64)",
            "tab_line": "rgb(200, 0, 80)",
            "tab_text": "rgb(255, 255, 255)",
            "toolbar": "rgb(24, 26, 29)",
            "toolbar_bottom_separator": "rgb(38, 41, 47)",
            "toolbar_field": "rgb(17, 18, 20)",
            "toolbar_field_border": "rgb(38, 41, 47)",
            "toolbar_field_border_focus": "rgb(200, 0, 80)",
            "toolbar_field_focus": "rgb(31, 34, 38)",
            "toolbar_field_highlight": "rgb(120, 0, 48)",
            "toolbar_field_highlight_text": "rgb(212, 212, 212)",
            "toolbar_field_text": "rgb(212, 212, 212)",
            "toolbar_text": "rgb(212, 212, 212)",
            "toolbar_top_separator": "rgb(38, 41, 47)",
            "toolbar_vertical_separator": "rgb(38, 41, 47)"
        },
        "properties": {
            "color_scheme": "dark",
            "panel_hover": "color-mix(in srgb, currentColor 9%, transparent)",
            "panel_active": "color-mix(in srgb, currentColor 14%, transparent)",
            "panel_active_darker": "color-mix(in srgb, currentColor 25%, transparent)",
            "toolbar_field_icon_opacity": "1",
            "zap_gradient": "linear-gradient(90deg, #C80050 0%, #A00040 52.08%, #780030 100%)"
        }
    }
}
