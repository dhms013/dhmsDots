{
  "name": "Dracula Theme",
  "extension": "dracula-theme.theme-dracula",
  "workbench.colorTheme": "Dracula Theme",
  "workbench.colorCustomizations": {
    "[Dracula Theme]": {
      "editor.background": "#111214",
      "terminal.background": "#111214",
      "activityBar.background": "#111214",
      "activityBarBadge.background": "#C80050",
      "activityBarBadge.foreground": "#d4d4d4",
      "sideBar.background": "#111214",
      "sideBarSectionHeader.background": "#181a1d",
      "editorGroupHeader.tabsBackground": "#111214",
      "tab.activeBackground": "#111214",
      "tab.inactiveBackground": "#181a1d",
      "editorWidget.background": "#181a1d",
      "editorWidget.border": "#26292f",
      "focusBorder": "#26292f",
      "button.background": "#A00040",
      "button.hoverBackground": "#C80050",
      "textLink.foreground": "#C80050",
      "textLink.activeForeground": "#A00040",
      "editorCursor.foreground": "#C80050",
      "terminalCursor.foreground": "#C80050",
      "editorLineNumber.foreground": "#80868f",
      "editorLineNumber.activeForeground": "#C80050",
      "editor.selectionBackground": "#1f2226",
      "editor.lineHighlightBackground": "#181a1d",
      "list.highlightForeground": "#C80050",
      "list.activeSelectionBackground": "#1f2226",
      "list.hoverBackground": "#181a1d",
      "progressBar.background": "#A00040",
      "pickerGroup.foreground": "#80868f",
      "tab.activeBorder": "#C80050",
      "notificationLink.foreground": "#C80050",
      "terminal.ansiBlack": "#26292f",
      "terminal.ansiRed": "#ff0055",
      "terminal.ansiGreen": "#00ff66",
      "terminal.ansiYellow": "#ffea00",
      "terminal.ansiBlue": "#0088ff",
      "terminal.ansiMagenta": "#bd93f9",
      "terminal.ansiCyan": "#00eeff",
      "terminal.ansiWhite": "#d4d4d4",
      "terminal.ansiBrightBlack": "#4d4d4d",
      "terminal.ansiBrightRed": "#ff5588",
      "terminal.ansiBrightGreen": "#55ff99",
      "terminal.ansiBrightYellow": "#ffff55",
      "terminal.ansiBrightBlue": "#55aaff",
      "terminal.ansiBrightMagenta": "#bd93f9",
      "terminal.ansiBrightCyan": "#55ffff",
      "terminal.ansiBrightWhite": "#ffffff"
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Dracula Theme]": {
      "enabled": true,
      "rules": {
        "parameter": { "foreground": "#ff79c6", "fontStyle": "italic" },
        "property": { "foreground": "#d4d4d4" }
      }
    }
  },
  "editor.tokenColorCustomizations": {
    "[Dracula Theme]": {
      "textMateRules": [
        {
          "scope": ["comment", "punctuation.definition.comment"],
          "settings": { "foreground": "#80868f", "fontStyle": "italic" }
        },
        {
          "scope": [
            "keyword",
            "storage",
            "storage.type",
            "entity.name.tag.css",
            "keyword.control"
          ],
          "settings": { "foreground": "#C80050" }
        },
        {
          "scope": [
            "entity.name.function",
            "support.function",
            "entity.name.tag",
            "meta.function-call"
          ],
          "settings": { "foreground": "#00eeff" }
        },
        {
          "scope": [
            "entity.name.type",
            "entity.name.class",
            "support.type",
            "support.class",
            "entity.other.inherited-class"
          ],
          "settings": { "foreground": "#ffea00" }
        },
        {
          "scope": [
            "string",
            "punctuation.definition.string",
            "string.quoted.double",
            "string.quoted.single"
          ],
          "settings": { "foreground": "#00ff66" }
        },
        {
          "scope": ["variable.parameter", "entity.name.variable.parameter"],
          "settings": { "foreground": "#bd93f9", "fontStyle": "italic" }
        },
        {
          "scope": [
            "variable",
            "support.variable",
            "punctuation.definition.variable",
            "variable.other.readwrite",
            "variable.other.property",
            "support.variable.property"
          ],
          "settings": { "foreground": "#d4d4d4" }
        },
        {
          "scope": [
            "constant.numeric",
            "constant.language",
            "constant.character",
            "constant.other"
          ],
          "settings": { "foreground": "#C80050" }
        },
        {
          "scope": ["keyword.operator"],
          "settings": { "foreground": "#ff0055" }
        },
        {
          "scope": [
            "punctuation",
            "meta.brace",
            "punctuation.definition.parameters",
            "punctuation.definition.block"
          ],
          "settings": { "foreground": "#d4d4d4" }
        },
        {
          "scope": ["entity.name.namespace", "entity.name.type.namespace"],
          "settings": { "foreground": "#d4d4d4" }
        }
      ]
    }
  }
}
