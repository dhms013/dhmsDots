/* Generated by theme-template. Colors are supplied by the active theme. */
:root {
  color-scheme: {{ mode }};
  --dhms-zen-background: {{ background }};
  --dhms-zen-surface: {{ dark_background }};
  --dhms-zen-surface-raised: {{ lighter_background }};
  --dhms-zen-foreground: {{ foreground }};
  --dhms-zen-muted: {{ muted }};
  --dhms-zen-accent: {{ accent }};
  --dhms-zen-selection: {{ selection }};
}

/* Zen and Firefox browser chrome only. Web content and internal pages keep
 * their own colors; these selectors target browser UI documents/elements. */
#navigator-toolbox,
#TabsToolbar,
#PersonalToolbar,
#nav-bar,
#zen-sidebar-top,
#zen-sidebar-bottom {
  background-color: var(--dhms-zen-background) !important;
  color: var(--dhms-zen-foreground) !important;
}

#urlbar-background,
#searchbar,
.urlbar-background,
.searchbar-textbox {
  background-color: var(--dhms-zen-surface) !important;
  color: var(--dhms-zen-foreground) !important;
  border-color: var(--dhms-zen-muted) !important;
}

tab,
.tabbrowser-tab,
#zen-sidebar-splitter {
  color: var(--dhms-zen-foreground) !important;
}

tab[selected="true"],
.tabbrowser-tab[selected="true"],
menuitem[_moz-menuactive="true"],
menuitem:hover,
toolbarbutton:hover {
  background-color: var(--dhms-zen-selection) !important;
  color: var(--dhms-zen-foreground) !important;
}

menupopup,
panel,
tooltip {
  --panel-background: var(--dhms-zen-surface-raised) !important;
  --panel-color: var(--dhms-zen-foreground) !important;
  background-color: var(--dhms-zen-surface-raised) !important;
  color: var(--dhms-zen-foreground) !important;
}

toolbarbutton,
menu,
menuitem,
label,
.tab-text {
  color: var(--dhms-zen-foreground) !important;
}
