{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 7,
  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  "modules-left": [
    "custom/space",
    "custom/start",
    "temperature",
    "cpu",
    "memory",
    "custom/end",
    "custom/space"
  ],
  "modules-center": [
    "custom/space",
    "custom/start",
    "hyprland/workspaces",
    "custom/screenrecording-indicator",
    "custom/end",
    "custom/space"
  ],
  "modules-right": [
    "custom/space",
    "custom/start",
    "network#speed",
    "clock",
    "group/tray-expander",
    "battery",
    "custom/end",
    "custom/space"
  ]
}
