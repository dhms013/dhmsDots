{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 20,
  "include": [
    "~/.config/waybar/modules.jsonc"
  ],
  "modules-left": [
    "temperature",
    "cpu",
    "memory",
    "hyprland/window"
  ],
  "modules-center": [
    "hyprland/workspaces",
    "custom/screenrecording-indicator"
  ],
  "modules-right": [
    "network#speed",
    "clock",
    "custom/notification",
    "group/tray-expander",
    "battery"
  ]
}
