{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 20,
  "modules-left": [
    "temperature",
    "cpu",
    "custom/gpu",
    "custom/gpu-temp",
    "memory",
    "hyprland/window"
  ],
  "modules-center": [
    "hyprland/workspaces",
    "custom/screenrecording-indicator"
  ],
  "modules-right": [
    "network#speed",
    "network",
    "bluetooth",
    "pulseaudio",
    "custom/ddc_brightness",
    "clock",
    "custom/notification",
    "group/tray-expander",
    // "power-profiles-daemon",
    "battery"
  ],
  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      // "default": "零",
      // "active": " ",
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十"
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },
  "custom/menu": {
    "format": "𐤃𐤄𐤌𐤑",
    "on-click": "~/.config/scripts/custom-menu",
    "tooltip-format": "menu"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 16,
    "icon": true,
    "icon-size": 13,
    "tooltip": true,
    "rewrite": {
      "nvim": "eovim ",
      "WhatsApp": " WhatsApp "
    },
    "swap-icon-label": false
  },
  "custom/notification": {
    "format": "",
    "on-click": "xdg-terminal-exec --title=float -e sh -c 'makoctl history && echo \"---\" && read -p \"Dismiss all active? (y/N): \" choice && [ \"$choice\" = \"y\" ] && makoctl dismiss -a && makoctl reload' &",
    "tooltip": false,
    "restart-interval": 1
  },
  "temperature": {
    "critical-threshold": 90,
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "format": " {temperatureC}°C",
    "format-critical": "🔥 {temperatureC}°C",
    "tooltip": true,
    "on-click": "xdg-terminal-exec --title=float -e btop",
    "interval": 3
  },
  "cpu": {
    "format": "󰍛 {usage}%",
    "on-click": "xdg-terminal-exec --title=float -e btop",
    "interval": 3
  },
  "custom/gpu": {
    "format": "󰾲  {}%",
    "tooltip": false,
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
    "on-click": "xdg-terminal-exec --title=float -e nvtop",
    "interval": 3
  },
  "custom/gpu-temp": {
    "format": " {}°C",
    "tooltip": false,
    "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
    "on-click": "xdg-terminal-exec --title=float -e nvtop",
    "interval": 3
  },
  "memory": {
    "format": "  {used}G/{total}G",
    "on-click": "xdg-terminal-exec --title=float -e btop",
    "interval": 3
  },
  "clock": {
    "format": " {:L%a %d, %H:%M} ",
    "format-alt": " {:L%A %d/%m/%Y} ",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    }
  },
  "network#speed": {
    "format-wifi": "⇣{bandwidthDownBytes} ⇡{bandwidthUpBytes}",
    "format-ethernet": "⇣{bandwidthDownBytes} ⇡{bandwidthUpBytes}",
    "format-disconnected": "",
    "on-click": "xdg-terminal-exec --title=float -e cloudflare-speed-cli",
    "interval": 1
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes} ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 1,
    "spacing": 1,
    "on-click": "xdg-terminal-exec --title=float -e impala"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "battery": {
    "format": "{capacity}%{icon}",
    "format-discharging": "{capacity}%{icon}",
    "format-charging": "{capacity}%{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "format-full": "{capacity}% 󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "~/.config/scripts/power-menu",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "xdg-terminal-exec --title=float -e bluetui"
  },
  "pulseaudio": {
    "format": "{icon}",
    "on-click": "xdg-terminal-exec --title=float -e wiremix",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "custom/ddc_brightness": {
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "exec": "~/.config/scripts/brightness get",
    "return-type": "json",
    "on-scroll-up": "~/.config/scripts/brightness up",
    "on-scroll-down": "~/.config/scripts/brightness down",
    "on-click-right": "~/.config/scripts/brightness mid",
    "interval": "once",
    "signal": 10,
    "tooltip": true,
    "tooltip-format": "Brightness: {percentage}%"
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": [
      "custom/expand-icon",
      "tray"
    ]
  },
  "custom/expand-icon": {
    "format": "  ",
    "tooltip": false
  },
  "custom/power": {
    "format": "󰐥",
    "on-click": "~/.config/scripts/custom-menu system",
    "tooltip": false
  },
  "tray": {
    "icon-size": 12,
    "spacing": 5
  }
}
