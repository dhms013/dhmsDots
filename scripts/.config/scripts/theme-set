#!/bin/bash

# Add logging at the start
echo "$(date): theme-set called with args: $@" >>/tmp/theme-set.log

if [[ -z $1 && $1 != "CNCLD" ]]; then
  echo "Usage: theme-set <theme-name>"
  exit 1
fi

THEMES_DIR="$HOME/.config/themes/themeLists/"
CURRENT_THEME_DIR="$HOME/.config/themes/current/theme"

THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Check if the theme entered exists
if [[ ! -d "$THEME_PATH" ]]; then
  echo "Theme '$THEME_NAME' does not exist in $THEMES_DIR"
  exit 1
fi

# Update theme symlinks
ln -nsf "$THEME_PATH" "$CURRENT_THEME_DIR"

# Update backgrounds using the first backgrounds

ln -sf "$(find ~/.config/themes/current/theme/backgrounds/ -type f | sort | head -n 1)" ~/.config/themes/current/background
awww img ~/.config/themes/current/background --transition-type 'random' --transition-fps 60 --transition-duration 1

systemctl --user restart waybar

xdg-terminal-exec waybar &

if pgrep -x kitty; then
  killall -SIGUSR1 kitty
fi

if pgrep -x ghostty; then
  killall -SIGUSR2 ghostty
fi

hyprctl reload
pkill -SIGUSR2 btop
makoctl reload

pkill swayosd-server
systemctl --user restart swayosd-server.service

systemctl --user restart elephant.service

pkill walker
walker --gapplication-service
