#!/bin/bash

_detect_backend() {
  for bat in /sys/class/power_supply/BAT*; do
    [ -d "$bat" ] && {
      echo "brightnessctl"
      return
    }
  done
  if command -v ddcutil >/dev/null 2>&1 && ddcutil detect 2>/dev/null | grep -q "Display"; then
    echo "ddcutil"
  else
    echo "brightnessctl"
  fi
}

BACKEND=$(_detect_backend)

update_waybar() {
  pkill -RTMIN+10 waybar
}

case "${1:-get}" in
get)
  if [ "$BACKEND" = "brightnessctl" ]; then
    read -r current max <<<"$(brightnessctl i 2>/dev/null | awk -F'[:()/]' '/Current brightness/{print $2+0, $3+0}')"
    if [[ "$max" -gt 0 ]]; then
      perc=$((current * 100 / max))
    else
      perc=0
    fi
    echo "{\"percentage\": $perc}"
  else
    v=$(ddcutil getvcp 10 2>/dev/null | grep -oP 'current value =\s*\K[0-9]+')
    echo "{\"percentage\": ${v:-0}}"
  fi
  ;;

up)
  if [ "$BACKEND" = "brightnessctl" ]; then
    brightnessctl -q s +5%
  else
    ddcutil setvcp 10 + 5
  fi
  update_waybar
  ;;

down)
  if [ "$BACKEND" = "brightnessctl" ]; then
    brightnessctl -q s 5%-
  else
    ddcutil setvcp 10 - 5
  fi
  update_waybar
  ;;

mid)
  if [ "$BACKEND" = "brightnessctl" ]; then
    brightnessctl -q s 50%
  else
    ddcutil setvcp 10 50
  fi
  update_waybar
  ;;

*)
  echo "Usage: $0 [get|up|down|mid]"
  exit 1
  ;;
esac
