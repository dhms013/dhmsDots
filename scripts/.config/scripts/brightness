#!/bin/bash

# Check if ddcutil can find monitors
if command -v ddcutil &>/dev/null && ddcutil detect &>/dev/null && [ $(ddcutil detect 2>/dev/null | grep -c "Display") -gt 0 ]; then
    USE_DDC=true
else
    USE_DDC=false
fi

case "$1" in
    get)
        if $USE_DDC; then
            v=$(ddcutil getvcp 10 2>/dev/null | grep -oP "current value =\s*\K[0-9]+")
            echo "{\"percentage\": ${v:-0}}"
        else
            if command -v brightnessctl &>/dev/null; then
                v=$(brightnessctl g 2>/dev/null)
                max=$(brightnessctl m 2>/dev/null)
                if [ -n "$v" ] && [ -n "$max" ] && [ "$max" -gt 0 ]; then
                    pct=$((v * 100 / max))
                    echo "{\"percentage\": $pct}"
                else
                    echo "{\"percentage\": 50}"
                fi
            else
                echo "{\"percentage\": 50}"
            fi
        fi
        ;;
    up)
        if $USE_DDC; then
            ddcutil setvcp 10 + 5
        else
            brightnessctl s +5%
        fi
        ;;
    down)
        if $USE_DDC; then
            ddcutil setvcp 10 - 5
        else
            brightnessctl s 5%-
        fi
        ;;
    set)
        if $USE_DDC; then
            ddcutil setvcp 10 $2
        else
            brightnessctl s $2%
        fi
        ;;
esac
