@import "~/.config/themes/current/theme/rofi.rasi"

* {
    background-color: transparent;
    text-color:       @text;
    font:             "JetBrainsMono Nerd Font 10";
}

window {
    background-color: @base;
    border:           1px solid;
    border-color:     @border;
    border-radius:    16px;
    width:            250px;
    height:           300px;
    padding:          10px;
    spacing:          10px;
}

mainbox {
    spacing:  10px;
    children: [inputbar, listview];
}

inputbar {
    background-color: transparent;
    border:           1px solid;
    border-color:     @border;
    border-radius:    8px;
    padding:          10px 12px;
    children:         [entry];
}

entry {
    placeholder:       " Search...";
    placeholder-color: @border;
    text-color:        @selected-text;
    cursor-color:      transparent;
}

listview {
    background-color: @base;
    border:           1px solid;
    border-color:     @border;
    border-radius:    8px;
    lines:            5;
    spacing:          0;
    scrollbar:        false;
}

element {
    padding:          10px;
    border-radius:    6px;
    background-color: transparent;
    text-color:       @text;
    orientation:      horizontal;
    spacing:          10px;
}

element-icon {
    size:           20px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}

element selected {
    text-color:       @selected-text;
}

element selected .element-icon {
    text-color: @selected-text;
}
