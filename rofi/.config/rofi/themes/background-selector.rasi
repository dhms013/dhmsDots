@import "~/.config/themes/current/theme/rofi.rasi"

* {
    background-color: transparent;
    text-color:       @text;
    font:             "JetBrainsMono Nerd Font 10";
}

window {
    background-color: @base;
    border:           1px solid;
    border-color:     @border;
    border-radius:    25px;
    width:            40%;
    height:           37%;
    location:         center;
    padding:          20px;
}

mainbox {
    spacing:  10px;
    children: [inputbar, listview];
}

inputbar {
    background-color: transparent;
    border:           1px solid;
    border-color:     @border;
    border-radius:    8px;
    padding:          10px 12px;
    children:         [entry];
}

entry {
    placeholder:       " Search background...";
    placeholder-color: @border;
    text-color:        @selected-text;
    cursor-color:      transparent;
}

listview {
    background-color: @base;
    border:           1px solid;
    border-color:     @border;
    border-radius:    18px;
    columns:          3;
    lines:            1;
}

element {
    orientation: vertical;
    padding:     10px;
    border-radius: 16px;
    background-color: transparent;
}

element-icon {
    size:        250px;
}

element-text {
    font:            "sans-serif 11";
    horizontal-align: 0.5;
    text-color:      inherit;
}

element selected {
    background-color: rgba(255,255,255,0.07);
    border:           1px;
    border-color:     @selected-text;
    text-color:       @selected-text;
}
