#!/bin/bash

status=$(systemctl is-active docker)

gum style --border normal --padding "1 2" "Docker is $status"

if [[ -z $1 ]]; then
  action=$(gum choose on off)
else
  action=$1
fi

case "$status-$action" in
active-on)
  exit 0
  ;;
active-off)
  sudo systemctl stop docker docker.socket
  sudo systemctl disable docker
  ;;
inactive-on)
  sudo systemctl enable --now docker
  ;;
inactive-off)
  exit 0
  ;;
esac
