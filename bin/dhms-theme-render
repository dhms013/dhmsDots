#!/bin/bash

# dhms:summary=Render a named theme to a temporary output directory without committing it
# dhms:hidden=true
# dhms:args=<theme-name> <output-dir>

[[ $# == 2 && $1 && $1 != */* && $1 != . && $1 != .. ]] || exit 2
export PALETTE_PREVIEW=1
exec theme-template --render-dir "$HOME/.config/themes/themeLists/$1" "$2"
