#!/bin/bash

# dhms:summary=Upgrade official-repo and AUR packages, pinning blackarch/omarchy packages out of the repo upgrade when the AUR also ships them (hermes stays on omarchy)
# dhms:requires-sudo=true

set -euo pipefail

# Official > AUR > omarchy > blackarch. A package that an extra repo
# (blackarch/omarchy) ships AND the AUR also ships is pinned out of the repo
# upgrade (`--ignore`) and updated by the AUR phase instead. Repo placement in
# /etc/pacman.conf resolves omarchy vs blackarch for the rest.
#
# Hermes is the exception: it is pinned to the omarchy repository. Even though
# the AUR names a `hermes-desktop` too (an unrelated app), hermes is never
# AUR-managed — the repo upgrade always provides it from omarchy.

echo -e "\033[38;2;0;204;119mUpdating packages\033[0m"

PIN=""
AUR_OK=1

EXTRA_REPOS=(blackarch omarchy)
readarray -t cands < <({
  for repo in "${EXTRA_REPOS[@]}"; do
    pacman -Slq "$repo" 2>/dev/null || true
  done
} | sort -u | comm -12 - <(pacman -Qq | sort))

# Hermes never pinned out of the repo upgrade.
readarray -t cands < <(printf '%s\n' "${cands[@]}" 2>/dev/null | grep -vE '^hermes' || true)

if [ "${#cands[@]}" -gt 0 ]; then
    in_aur=""
    for ((i = 0; i < ${#cands[@]}; i += 200)); do
      batch=("${cands[@]:i:200}")
      url="https://aur.archlinux.org/rpc/v5/info?$(printf 'arg[]=%s&' "${batch[@]}")"
      if out=$(curl -fsS --connect-timeout 5 --max-time 15 "$url" | jq -r '.results[]?.Name' 2>/dev/null); then
        in_aur+="${out}"$'\n'
      else
        AUR_OK=0
        break
      fi
    done

    if [ "$AUR_OK" -eq 0 ]; then
      PIN=$(printf '%s\n' "${cands[@]}" | paste -sd, -) # AUR unreachable → pin everything
    else
      PIN=$(comm -12 \
        <(printf '%s\n' "${cands[@]}" | sort) \
        <(printf '%s\n' "$in_aur" | sort) | paste -sd, -)
    fi
fi

if [ -n "$PIN" ]; then
  sudo pacman -Syu --noconfirm --ignore="$PIN"
  paru -Sua --noconfirm --cleanafter
else
  paru -Syyu --noconfirm --cleanafter
fi
