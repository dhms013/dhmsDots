#!/bin/bash

# Ensure we have the latest archlinux-keyring, maintainer keys might have changed
gum log --level info "Update Arch signing keys"

sudo pacman -Sy --noconfirm

installed=$(pacman -Q archlinux-keyring 2>/dev/null | cut -d' ' -f2)
available=$(pacman -Si archlinux-keyring 2>/dev/null | sed -n 's/^Version *: //p')

if [[ -z "$installed" ]] || { [[ -n "$available" ]] && [[ "$(vercmp "$available" "$installed")" -gt 0 ]]; }; then
  gum log --level info "Updating archlinux-keyring: $installed → $available"
  sudo pacman -S --noconfirm archlinux-keyring
  sudo pacman-key --init
  sudo pacman-key --populate archlinux
else
  gum log --level info "archlinux-keyring is up to date"
fi
