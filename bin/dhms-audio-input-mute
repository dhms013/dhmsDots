#!/bin/bash

# dhms:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  dhms-brightness-keyboard-mute on
  dhms-osd -i microphone-muted -m "Microphone muted"
else
  dhms-brightness-keyboard-mute off
  dhms-osd -i microphone -m "Microphone on"
fi
