#!/bin/bash

set -e

CURRENT_BRANCH=$(git -C $HOME/.dhmsDots rev-parse --abbrev-ref HEAD)
MAIN_BRANCH="main"
RESTORE_BRANCH=false
NVIDIA_MODULE=$(find /usr/lib/modules/$(uname -r) -name "nvidia.ko*" 2>/dev/null | head -1)

git_check_branch() {
  if [ "$CURRENT_BRANCH" != "$MAIN_BRANCH" ]; then
    CHOICE=$(gum choose "Go back to $CURRENT_BRANCH" "Stay on $MAIN_BRANCH" \
      --header "Currently on branch: $CURRENT_BRANCH")
    if [ "$CHOICE" = "Go back to $CURRENT_BRANCH" ]; then
      RESTORE_BRANCH=true
      REMOTE=$(git -C $HOME/.dhmsDots config --get "branch.$CURRENT_BRANCH.remote")
      git -C $HOME/.dhmsDots pull --rebase --autostash "$REMOTE" "$MAIN_BRANCH"
      git -C $HOME/.dhmsDots stash pop || true
    fi
  fi
  git -C $HOME/.dhmsDots/ checkout "$MAIN_BRANCH"
}

git_pull() {
  echo -e "\033[38;2;0;204;119mGit Pull\033[0m"
  git -C $HOME/.dhmsDots pull --autostash
  git -C $HOME/.dhmsDots --no-pager diff --check || git -C $HOME/.dhmsDots reset --merge
}

git_restore() {
  if [ "$RESTORE_BRANCH" = true ]; then
    echo -e "\033[38;2;0;204;119mRestore $CURRENT_BRANCH\033[0m"
    git -C $HOME/.dhmsDots checkout "$CURRENT_BRANCH"
    REMOTE=$(git -C $HOME/.dhmsDots config --get "branch.$CURRENT_BRANCH.remote")
    git -C $HOME/.dhmsDots pull --rebase --autostash "$REMOTE" main
  fi
}

show_update_log() {
  echo -e "\033[38;2;0;204;119mPackages Updated\033[0m"

  local start_line
  start_line=$(grep -n "starting full system upgrade" /var/log/pacman.log | tail -1 | cut -d: -f1)

  if [ -z "$start_line" ]; then
    echo "  No upgrade session found."
    return
  fi

  local upgraded
  upgraded=$(tail -n +"$start_line" /var/log/pacman.log | grep "\[ALPM\] upgraded" |
    sed 's/.*upgraded \(.*\) (\(.*\) -> \(.*\))/  \1: \2 → \3/')

  if [ -n "$upgraded" ]; then
    echo "$upgraded"
  else
    echo "  No packages were upgraded."
  fi
}

post_update() {
  show_update_log

  if [ /boot/vmlinuz-linux-zen -nt /proc/1 ] ||
    { [ -n "$NVIDIA_MODULE" ] && [ "$NVIDIA_MODULE" -nt /proc/1 ]; }; then
    gum confirm "Kernel/GPU driver updated. Reboot now?" && reboot --no-wall
  else
    notify-send "Update finished"
    show-done
  fi
}

hyprctl dispatch tagwindow +noidle &>/dev/null || true

show-logo
sudo-keep

git_check_branch

echo -e "\033[38;2;0;204;119mUpdating dhmsDots\033[0m"
keyrings
{ pkg-update; } || echo -e "\033[0;31mPackage update failed, continuing...\033[0m"
{ frmwr-updt; } || echo -e "\033[0;31mFirmware update failed, continuing...\033[0m"

git_pull
{ migrate-run; } || echo -e "/033[0;31mMigrate-run failed, continuing...\033[0m"
pkg-check-orphan
sudo updatedb

git_restore

post_update

hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
