#!/bin/bash

# dhms:summary=Update dhmsDots (branch-aware), keyrings, packages, firmware, then run migrations
# dhms:group=system
# dhms:name=update
# dhms:requires-sudo=true

set -e

DOTFILES="$HOME/.dhmsDots"
CURRENT_BRANCH=$(git -C "$DOTFILES" rev-parse --abbrev-ref HEAD)
MAIN_BRANCH="main"
RESTORE_BRANCH=false
NVIDIA_MODULE=$(find /usr/lib/modules/"$(uname -r)" -name "nvidia.ko*" 2>/dev/null | head -1)

input_password() {
  if ! sudo-keep; then
    exit 1
  fi
}

git_check_branch() {
  if [ "$CURRENT_BRANCH" != "$MAIN_BRANCH" ]; then
    gum style --border normal --padding "1 2" "Currently on branch: $CURRENT_BRANCH"
    CHOICE=$(gum choose "Go back to $CURRENT_BRANCH" "Stay on $MAIN_BRANCH")
    if [ "$CHOICE" = "Go back to $CURRENT_BRANCH" ]; then
      RESTORE_BRANCH=true
    fi
  fi

  local HAS_STASH=false
  if ! git -C "$DOTFILES" diff --quiet; then
    git -C "$DOTFILES" stash push -m "dhms-update"
    HAS_STASH=true
  fi

  if [ "$CURRENT_BRANCH" = "$MAIN_BRANCH" ]; then
    # Already on main: git forbids fetching into the checked-out branch,
    # so fast-forward via the remote-tracking ref instead.
    git -C "$DOTFILES" fetch origin
    git -C "$DOTFILES" merge --ff-only "origin/$MAIN_BRANCH"
  else
    git -C "$DOTFILES" fetch origin "$MAIN_BRANCH":"$MAIN_BRANCH"
  fi

  if [ "$RESTORE_BRANCH" = true ]; then
    # Rebase the host branch onto main; on conflict, abort cleanly and stay
    # on main rather than leaving the repo mid-rebase for every future run
    # to trip over.
    if ! git -C "$DOTFILES" rebase "$MAIN_BRANCH" "$CURRENT_BRANCH"; then
      git -C "$DOTFILES" rebase --abort
      gum log --level warn "Rebase of $CURRENT_BRANCH onto $MAIN_BRANCH conflicted — aborted. Resolve manually with: git -C $DOTFILES rebase $MAIN_BRANCH $CURRENT_BRANCH"
      RESTORE_BRANCH=false
    fi
  fi

  git -C "$DOTFILES" checkout -q "$MAIN_BRANCH"
  if [ "$HAS_STASH" = true ]; then
    # On conflict: leave the stash INTACT and finish. The stash holds the
    # user's only copy of their local changes — never overwrite or drop it
    # from a script. Manual recovery: `git stash pop` (or `git stash show -p`).
    if ! git -C "$DOTFILES" stash pop; then
      gum log --level warn "Stash conflict — your local changes are safe in 'git stash'. Resolve manually, then drop the stash."
      # The failed pop leaves conflict markers and staged entries in the
      # working tree; the tree was clean before the pop, so resetting it
      # restores HEAD without touching the (intact) stash.
      git -C "$DOTFILES" reset -q
      git -C "$DOTFILES" checkout -- .
    fi
  fi
}

git_restore() {
  if [ "$RESTORE_BRANCH" = true ]; then
    git -C "$DOTFILES" checkout "$CURRENT_BRANCH"
  fi
}

show_update_log() {
  local start_line
  start_line=$(grep -n "starting full system upgrade" /var/log/pacman.log | tail -1 | cut -d: -f1)

  if [ -z "$start_line" ]; then
    gum log --level info "No upgrade session found."
    return
  fi

  local upgraded
  upgraded=$(tail -n +"$start_line" /var/log/pacman.log | grep "\[ALPM\] upgraded" |
    sed 's/.*upgraded \(.*\) (\(.*\) -> \(.*\))/\1 \2 \3/')

  local failed
  failed=$(tail -n +"$start_line" /var/log/pacman.log | grep "\[ALPM\] warning" | grep -i "error\|failed" |
    sed 's/.*warning \(.*\) /\1/')

  if [ -n "$upgraded" ]; then
    while read -r pkg old new; do
      gum log --level info "$pkg: $old → $new"
    done <<<"$upgraded"
  fi

  if [ -n "$failed" ]; then
    while read -r pkg; do
      gum log --level error "$pkg: upgrade failed"
    done <<<"$failed"
  fi

  if [ -z "$upgraded" ] && [ -z "$failed" ]; then
    gum log --level info "No packages were upgraded."
  fi
}

post_update() {
  show_update_log

  # Kernel-agnostic reboot check: any /boot/vmlinuz-* newer than boot time
  # (no hardcoded kernel flavor — zen/mainline/lts all covered). NVIDIA
  # module for the RUNNING kernel is checked the same way.
  local kernel_updated=false img
  for img in /boot/vmlinuz-*; do
    [ -e "$img" ] || continue
    if [ "$img" -nt /proc/1 ]; then
      kernel_updated=true
      break
    fi
  done

  if [ "$kernel_updated" = true ] ||
    { [ -n "$NVIDIA_MODULE" ] && [ "$NVIDIA_MODULE" -nt /proc/1 ]; }; then
    gum style --border normal --padding "1 2" "Kernel/GPU driver updated. Rebooting in 3 minutes unless you answer No."
    if gum confirm --default true --timeout 3m; then
      reboot --no-wall
    fi
  else
    dhms-shell -q dhms.system-update refresh
    dhms-notification-send "Update finished"
  fi
}

hyprctl dispatch tagwindow +noidle &>/dev/null || true

show-logo
input_password

git_check_branch

echo -e "\033[38;2;0;204;119mUpdating dhmsDots\033[0m"
keyrings
{ pkg-update; } || echo -e "\033[0;31mPackage update failed, continuing...\033[0m"
{ frmwr-updt; } || echo -e "\033[0;31mFirmware update failed, continuing...\033[0m"

{ migrate-run; } || echo -e "\033[0;31mMigrate-run failed, continuing...\033[0m"
pkg-check-orphan
sudo updatedb

git_restore
hyprctl reload

post_update

hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
