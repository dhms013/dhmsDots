#!/bin/bash

# dhms:summary=Lock the desktop through the dhms shell lock plugin
# dhms:examples=dhms-lock | SUPER+CTRL+L and hypridle lock_cmd call this

# The plugin refuses to lock without its PAM config, so fail loudly here
# instead of letting the call come back "missing-pam".
if [[ ! -f /etc/pam.d/dhms-lock-password ]]; then
  echo "dhms-lock: /etc/pam.d/dhms-lock-password is missing — run 'dhms-apply-lock-pam' first (plain, no sudo prefix)." >&2
  exit 1
fi

exec dhms-shell lock lock
