#!/bin/bash

# dhms:summary=Control the fan (ThinkPad EC levels 0-7/auto/disengaged; desktop hwmon PWM)
# dhms:group=fan
# dhms:name=
# dhms:requires-sudo=true
# dhms:args=[auto|disengaged|toggle|status|<level>]
# dhms:examples=dhms fan | dhms fan disengaged | dhms fan auto | dhms fan toggle | dhms fan status | dhms fan 3 | dhms fan 50

set -euo pipefail

STATE_DIR="$HOME/.local/state/dhms"
TOGGLE_STATE="$STATE_DIR/fan-toggle"
AUTO_MODE_STATE="$STATE_DIR/fan-auto-mode"
# On the B650M Pro RS, pwm1 is CPU_FAN2/WP and pwm2 is CPU_FAN1, so default to
# the CPU fan header rather than the water-pump header.
board_name=$(cat /sys/devices/virtual/dmi/id/board_name 2>/dev/null || true)
case "$board_name" in
"B650M Pro RS") default_pwm=pwm2 ;;
*) default_pwm=pwm1 ;;
esac
FAN_PWM="${DHMS_FAN_PWM:-$default_pwm}"
FAN_PWM_ENABLE="${FAN_PWM}_enable"
FAN_INPUT="${FAN_PWM/pwm/fan}_input"

# Backend: ThinkPad EC (/proc/acpi/ibm/fan) when present, otherwise a generic
# hwmon PWM controller (pwmN_enable + pwmN) — e.g. a desktop motherboard.
if [[ -r /proc/acpi/ibm/fan ]]; then
  BACKEND=thinkpad
else
  BACKEND=hwmon
fi

notify() {
  notify-send -u low "󰈐  Fan: $1" "$2"
}

# Safety: confirm interactive low-fan states. Scripted/non-TTY runs skip the
# prompt (the caller chose a low state deliberately).
confirm_low() {
  if [[ -t 0 ]]; then
    gum confirm "This sets the fan to $1 — overheating risk. Apply anyway?" || {
      echo "dhms-fan: cancelled" >&2
      return 1
    }
  fi
}

# Equal-for-equal toggle: remember the last non-max state so toggle can return
# to it (auto<->disengaged, level 3<->disengaged, 50%<->max, ...).
remember_ordinary() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" > "$TOGGLE_STATE"
}

stored_ordinary() {
  if [[ -f "$TOGGLE_STATE" && -s "$TOGGLE_STATE" ]]; then
    cat "$TOGGLE_STATE"
  else
    echo auto
  fi
}

# ────────────────────────── ThinkPad EC backend ──────────────────────────
TP_FAN=/proc/acpi/ibm/fan

tp_level() {
  awk -F': *' '/^level:/{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2}' "$TP_FAN"
}

tp_speed() {
  awk -F': *' '/^speed:/{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2}' "$TP_FAN"
}

tp_set() {
  local level=$1

  if ! echo "level $level" | sudo tee "$TP_FAN" >/dev/null; then
    echo "dhms-fan: could not write to $TP_FAN (sudo failed)" >&2
    return 1
  fi

  local actual
  actual=$(tp_level)
  if [[ $actual != "$level" ]]; then
    echo "dhms-fan: level is still '$actual', not '$level' — is thinkpad_acpi fan_control=1 set (see /etc/modprobe.d/thinkpad-fan.conf)?" >&2
    return 1
  fi
}

tp_apply() {
  local mode=$1

  case "$mode" in
  auto)
    tp_set auto
    remember_ordinary auto
    notify auto "EC temperature control"
    ;;
  disengaged|max|full-speed)
    tp_set disengaged
    notify disengaged "set to full speed"
    ;;
  [0-7])
    if (( mode <= 2 )); then
      confirm_low "level $mode (fan nearly off)"
    fi
    tp_set "$mode"
    remember_ordinary "$mode"
    notify "level $mode" "set to level $mode"
    ;;
  *)
    return 2
    ;;
  esac
}

# ────────────────────────── hwmon PWM backend ──────────────────────────
hwmon_device() {
  # Prefer DHMS_FAN_HWMON (e.g. "hwmon6" or a full path), else the first
  # controller exposing the selected PWM channel — favouring one that also
  # reports the matching fan input.
  if [[ -n ${DHMS_FAN_HWMON:-} ]]; then
    local p=$DHMS_FAN_HWMON
    [[ $p == /* ]] || p="/sys/class/hwmon/$p"
    printf '%s\n' "$p"
    return
  fi

  local h fallback=""
  for h in /sys/class/hwmon/hwmon*; do
    [[ -e "$h/$FAN_PWM" && -e "$h/$FAN_PWM_ENABLE" ]] || continue
    if [[ -e "$h/$FAN_INPUT" ]]; then
      printf '%s\n' "$h"
      return
    fi
    [[ -z $fallback ]] && fallback=$h
  done
  printf '%s\n' "$fallback"
}

# ASRock/ASUS desktop Super-I/O chips are not auto-loaded; the nct6775 family
# (NCT6799D on the B650M Pro RS) must be probed explicitly. The script already
# needs root for writes, so load it once here instead of failing with no PWM.
load_hwmon_driver() {
  local mod
  for mod in nct6775 nct6683 it87; do
    if [[ ! -d /sys/module/$mod ]]; then
      echo "dhms-fan: loading $mod for hwmon access" >&2
      sudo modprobe "$mod" 2>/dev/null || true
    fi
    HWMON="$(hwmon_device)"
    if [[ -n $HWMON && -e "$HWMON/$FAN_PWM" && -e "$HWMON/$FAN_PWM_ENABLE" ]]; then
      return 0
    fi
  done
  return 1
}

if [[ $BACKEND == hwmon ]]; then
  HWMON="$(hwmon_device)"
  if [[ -z $HWMON || ! -e "$HWMON/$FAN_PWM" || ! -e "$HWMON/$FAN_PWM_ENABLE" ]]; then
    load_hwmon_driver || true
  fi
  if [[ -z $HWMON || ! -e "$HWMON/$FAN_PWM" || ! -e "$HWMON/$FAN_PWM_ENABLE" ]]; then
    echo "dhms-fan: no hwmon $FAN_PWM controller found — set DHMS_FAN_HWMON/DHMS_FAN_PWM to override" >&2
    exit 1
  fi
fi

hw_read() {
  [[ -r $HWMON/$1 ]] || return 0
  tr -d ' ' < "$HWMON/$1" 2>/dev/null || true
}

hw_write() {
  local attr=$1 value=$2
  if ! echo "$value" | sudo tee "$HWMON/$attr" >/dev/null; then
    echo "dhms-fan: could not write $HWMON/$attr (sudo failed)" >&2
    return 1
  fi
}

# pwmN_enable: 0 = full speed, 1 = manual, 2 = Thermal Cruise (auto),
# 3 = Fan Speed Cruise, 4 = Smart Fan III, 5 = Smart Fan IV. Modern BIOS fan
# curves use 5, so `auto` must restore the mode the BIOS was in rather than
# forcing Thermal Cruise.
mode_label() {
  case "$1" in
  0) echo "full speed" ;;
  1) echo manual ;;
  2) echo "Thermal Cruise" ;;
  3) echo "Fan Speed Cruise" ;;
  4) echo "Smart Fan III" ;;
  5) echo "Smart Fan IV" ;;
  *) echo "mode $1" ;;
  esac
}

stored_auto_mode() {
  if [[ -f $AUTO_MODE_STATE && -s $AUTO_MODE_STATE ]]; then
    cat "$AUTO_MODE_STATE" 2>/dev/null || true
  fi
}

remember_auto_mode() {
  local mode=$1
  [[ $mode =~ ^[0-9]+$ ]] || return 0
  (( mode == 1 )) && return 0
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$mode" > "$AUTO_MODE_STATE"
}

capture_auto_mode() {
  local mode
  mode=$(hw_read "$FAN_PWM_ENABLE")
  [[ -n $mode ]] && remember_auto_mode "$mode"
}

hw_apply() {
  local mode=$1

  case "$mode" in
  auto)
    local current saved
    current=$(hw_read "$FAN_PWM_ENABLE")
    saved=$(stored_auto_mode)
    if [[ -n $saved ]]; then
      hw_write "$FAN_PWM_ENABLE" "$saved"
      notify auto "$(mode_label "$saved")"
    elif [[ $current != 1 ]]; then
      remember_auto_mode "$current"
      notify auto "$(mode_label "$current") — already automatic"
    else
      hw_write "$FAN_PWM_ENABLE" 2
      notify auto "Thermal Cruise"
    fi
    remember_ordinary auto
    ;;
  max|disengaged|full-speed)
    capture_auto_mode
    hw_write "$FAN_PWM_ENABLE" 1
    hw_write "$FAN_PWM" 255
    notify max "set to 100% duty (max)"
    ;;
  *)
    if [[ $mode =~ ^[0-9]+$ && $mode -ge 0 && $mode -le 100 ]]; then
      if (( mode <= 25 )); then
        confirm_low "${mode}% duty (fan off/low)"
      fi
      local duty=$(( mode * 255 / 100 ))
      capture_auto_mode
      hw_write "$FAN_PWM_ENABLE" 1
      hw_write "$FAN_PWM" "$duty"
      remember_ordinary "$mode"
      if (( mode == 0 )); then
        notify "0%" "set to 0% — fan off"
      else
        notify "${mode}%" "set to ${mode}% duty (pwm $duty/255)"
      fi
    else
      return 2
    fi
    ;;
  esac
}

# ────────────────────────── shared commands ──────────────────────────
valid_for_backend() {
  local v=$1
  if [[ $BACKEND == thinkpad ]]; then
    case "$v" in
    auto|disengaged|max|full-speed) return 0 ;;
    *) [[ $v =~ ^[0-7]$ ]] ;;
    esac
  else
    case "$v" in
    auto|disengaged|max|full-speed) return 0 ;;
    *) [[ $v =~ ^([0-9]|[1-9][0-9]|100)$ ]] ;;
    esac
  fi
}

apply() {
  if [[ $BACKEND == thinkpad ]]; then
    tp_apply "$1"
  else
    hw_apply "$1"
  fi
}

do_status() {
  if [[ $BACKEND == thinkpad ]]; then
    printf 'level: %s\nspeed: %s\n' "$(tp_level)" "$(tp_speed)"
  else
    local mode duty rpm
    mode=$(hw_read "$FAN_PWM_ENABLE")
    duty=$(hw_read "$FAN_PWM")
    rpm=$(hw_read "$FAN_INPUT")
    [[ $mode != 1 ]] && remember_auto_mode "$mode"
    printf 'channel: %s\nmode: %s (%s)\npwm: %s/255\nspeed: %s\n' \
      "$FAN_PWM" "$mode" "$(mode_label "$mode")" "$duty" "${rpm:-n/a}"
  fi
}

do_toggle() {
  local ordinary
  if [[ $BACKEND == thinkpad ]]; then
    if [[ $(tp_level) == disengaged ]]; then
      apply "$(stored_ordinary)"
    else
      remember_ordinary "$(tp_level)"
      apply disengaged
    fi
  else
    local mode duty pct
    mode=$(hw_read "$FAN_PWM_ENABLE")
    duty=$(hw_read "$FAN_PWM")
    pct=$(( duty * 100 / 255 ))
    if [[ $mode == 1 && $pct -ge 100 ]]; then
      apply "$(stored_ordinary)"
    else
      if [[ $mode == 1 ]]; then ordinary=$pct; else ordinary=auto; fi
      remember_ordinary "$ordinary"
      apply max
    fi
  fi
}

do_menu() {
  local current speed choice sel
  if [[ $BACKEND == thinkpad ]]; then
    current=$(tp_level)
    speed=$(tp_speed)
    case "$current" in
    auto) sel=Auto ;;
    disengaged) sel=Disengaged ;;
    0) sel="0 (off)" ;;
    *) sel=$current ;;
    esac
    choice=$(printf 'Auto\nDisengaged\n0 (off)\n1\n2\n3\n4\n5\n6\n7\n' | gum choose \
      --header="Fan level — current: $current · $speed RPM" \
      --selected="$sel") || true
    [[ -n $choice ]] || return 0
    case "$choice" in
    Auto) apply auto ;;
    Disengaged) apply disengaged ;;
    "0 (off)") apply 0 ;;
    *) apply "$choice" ;;
    esac
  else
    local duty pct mode
    mode=$(hw_read "$FAN_PWM_ENABLE")
    duty=$(hw_read "$FAN_PWM")
    if [[ $mode != 1 ]]; then
      pct=auto
      sel=Auto
    else
      pct=$(( duty * 100 / 255 ))
      if (( pct >= 88 )); then sel="100% max"
      elif (( pct >= 63 )); then sel="75%"
      elif (( pct >= 38 )); then sel="50%"
      elif (( pct >= 13 )); then sel="25%"
      else sel="0% off"
      fi
    fi
    choice=$(printf 'Auto\n100%% max\n75%%\n50%%\n25%%\n0%% off\n' | gum choose \
      --header="Fan $FAN_PWM — current: $pct · pwm $duty/255 · $(mode_label "$mode")" \
      --selected="$sel") || true
    [[ -n $choice ]] || return 0
    case "$choice" in
    Auto) apply auto ;;
    "100% max") apply max ;;
    "0% off") apply 0 ;;
    *) apply "${choice//%/}" ;;
    esac
  fi
}

usage() {
  if [[ $BACKEND == thinkpad ]]; then
    echo "Usage: dhms fan [auto|disengaged|toggle|status|0-7]" >&2
  else
    echo "Usage: dhms fan [auto|max|toggle|status|0-100]" >&2
    echo "       channel: $FAN_PWM (override with DHMS_FAN_PWM=pwmN)" >&2
  fi
  echo "       dhms fan            interactive fan menu" >&2
}

do_command() {
  local arg=$1
  case "$arg" in
  status) do_status ;;
  toggle) do_toggle ;;
  *)
    if ! valid_for_backend "$arg"; then
      usage
      return 1
    fi
    apply "$arg"
    ;;
  esac
}

case "${1:-}" in
"")
  do_menu
  ;;
status|toggle|auto|disengaged|max|full-speed)
  do_command "$1"
  ;;
*)
  v="${1:-}"
  [[ $v == *% ]] && v="${v%\%}"
  if [[ $v =~ ^[0-9]+$ ]]; then
    do_command "$v"
  else
    usage
    exit 1
  fi
  ;;
esac