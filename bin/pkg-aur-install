#!/bin/bash

# Show a fuzzy-finder TUI for picking new AUR packages to install.

fzf_args=(
  --multi
  --preview 'paru -Si {1}'
  --preview-label='alt-p: toggle description, alt-b/B: toggle PKGBUILD, ctrl-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --bind 'alt-b:change-preview:paru -Gp {1}'
  --bind 'alt-B:change-preview:paru -Si {1}'
  --color 'pointer:green,marker:green'
)

aur_pkg_list() {
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/paru"
  local cache_file="$cache_dir/packages"

  mkdir -p "$cache_dir"
  curl -sf 'https://aur.archlinux.org/packages.gz' | gzip -d >"$cache_file"
  bat "$cache_file"
}

pkg_names=$(aur_pkg_list | fzf "${fzf_args[@]}")

if [[ -n "$pkg_names" ]]; then
  show-logo
  sudo-keep
  echo -e "\033[38;2;0;204;119mInstalling...\033[0m"
  echo "$pkg_names" | tr ' ' '\n' | while read -r pkg; do
    echo -e "\033[38;2;0;204;119m$pkg\033[0m"
  done
  installed=()
  failed=()

  while read -r pkg; do
    if paru -S --noconfirm "$pkg"; then
      installed+=("$pkg")
    else
      failed+=("$pkg")
    fi
  done <<<"$pkg_names"

  sudo updatedb

  if [ ${#installed[@]} -gt 0 ]; then
    echo ""
    echo -e "\033[38;2;0;204;119mInstalled :\033[0m"
    for pkg in "${installed[@]}"; do
      echo -e "\033[38;2;0;204;119m  $pkg\033[0m"
    done
  fi

  if [ ${#failed[@]} -gt 0 ]; then
    echo ""
    echo -e "\033[0;31mFailed to install :\033[0m"
    for pkg in "${failed[@]}"; do
      echo -e "\033[0;31m  $pkg\033[0m"
    done
  fi
  show-done
fi
