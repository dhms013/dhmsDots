#!/bin/bash

# dhms:summary=Apply a theme by name and refresh running apps
# dhms:args=<theme-name>

if [[ -z $1 ]]; then
  echo "Usage: theme-set <theme-name>"
  exit 1
fi

export THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

restart_apps() {
  if command -v btop >/dev/null; then
    pkill -u "$UID" -SIGUSR2 -x btop || true
  fi
}

theme-template || exit 1
restart_apps
if command -v hyprctl >/dev/null; then hyprctl reload; fi
dhms-theme-live commit
if command -v gsettings >/dev/null; then theme-gnome; fi
theme-browser
if command -v hermes >/dev/null || [[ -x $HOME/.local/bin/hermes ]] || pacman -Qq hermes-desktop >/dev/null 2>&1; then
  hermes-theme-set
fi
