#!/bin/bash

if [[ -z $1 ]]; then
  echo "Usage: theme-set <theme-name>"
  exit 1
fi

export THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

restart_apps() {
  systemctl --user restart waybar

  if pgrep -x kitty; then
    killall -SIGUSR1 kitty
  fi

  if pgrep -x ghostty; then
    killall -SIGUSR2 ghostty
  fi

  hyprctl reload
  pkill -SIGUSR2 btop
  makoctl reload

  pkill swayosd-server
  systemctl --user restart swayosd-server.service
}

theme-template
theme-gnome
restart_apps
