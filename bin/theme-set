#!/bin/bash

if [[ -z $1 ]]; then
  echo "Usage: theme-set <theme-name>"
  exit 1
fi

export THEME_NAME=$(echo "$1" | sed -E 's/<[^>]+>//g' | tr '[:upper:]' '[:lower:]' | tr ' ' '-')

restart_terminal() {
  if pgrep -x kitty; then
    killall -SIGUSR1 kitty
  fi

  if pgrep -x ghostty; then
    killall -SIGUSR2 ghostty
  fi
}

theme-template
theme-gnome
restart_terminal
restart-services waybar
restart-services swayosd-server
makoctl reload
hyprctl reload
pkill -SIGUSR2 btop
