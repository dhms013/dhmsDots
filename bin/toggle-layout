#!/bin/bash

# dhms:summary=Toggle the Hyprland layout between dwindle and scrolling

CURRENT=$(hyprctl getoption general:layout | awk '/str:/ {print $2}')

case "$CURRENT" in
dwindle) NEW_LAYOUT=scrolling ;;
*) NEW_LAYOUT=dwindle ;;
esac

hyprctl eval "hl.config({ general = { layout = \"$NEW_LAYOUT\" }})"
notify-send -u low "󱂬    Layout set to $NEW_LAYOUT"
