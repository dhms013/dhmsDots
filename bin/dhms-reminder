#!/bin/bash

# dhms:summary=Stub reminder source that always reports an empty reminder list
#
# Stub until a reminder daemon exists. The bar indicator polls
# `dhms-reminder show --json`; report an empty list so it stays inactive.

case "${1:-}" in
  show)
    [[ ${2:-} == "--json" ]] && printf '{"reminders":[]}\n'
    ;;
esac
