#!/bin/bash

# dhms:summary=Print CPU and memory stats for the shell
# dhms:group=system
# dhms:args=[--bar-widget]

bar_widget_stats() {
  # Idle means idle PLUS iowait: btop and friends exclude iowait from
  # utilization, and this box accumulates enough of it that counting it as
  # busy would inflate the reading by tens of percent.
  awk '
    NR == 1 {
      idle = $5 + $6
      total = 0
      for (i = 2; i <= NF; i++) total += $i
      printf "cpu\t%s\t%s\n", idle, total
    }
    # Per-core tick lines (cpu0..cpuN): the widget derives per-core
    # utilization from deltas between consecutive samples.
    NR > 1 && /^cpu[0-9]+ / {
      idle = $5 + $6
      total = 0
      for (i = 2; i <= NF; i++) total += $i
      printf "core\t%d\t%s\t%s\n", substr($1, 4), idle, total
    }
  ' /proc/stat

  # RAM% counts swap in the total: (mem used + swap used) / (mem total + swap total).
  awk '
    /^MemTotal:/ { total = $2 }
    /^MemAvailable:/ { avail = $2 }
    /^SwapTotal:/ { swap_total = $2 }
    /^SwapFree:/ { swap_free = $2 }
    END {
      mem_used = total - avail
      swap_used = swap_total - swap_free
      grand = mem_used + swap_used
      if (grand > 0) printf "memory\t%.2f\n", (grand / (total + swap_total)) * 100
      printf "ramuse\t%d\t%d\n", mem_used, total
      printf "swapuse\t%d\t%d\n", swap_used, swap_total
    }
  ' /proc/meminfo

  awk '{ print "load\t" $1 }' /proc/loadavg
}

case "${1:-}" in
  "")
    ;;
  --bar-widget)
    bar_widget_stats
    exit
    ;;
  *)
    echo "Usage: dhms-system-stats [--bar-widget]" >&2
    exit 1
    ;;
esac

cpu=$(top -bn1 | awk '/^%?Cpu/ {
  gsub(/,/, "")
  for (i = 1; i <= NF; i++) {
    if ($(i + 1) == "id") {
      printf "%.0f%%", 100 - $i
      exit
    }
  }
}')

awk -v cpu="$cpu" '
  /^MemTotal:/ { total = $2 }
  /^MemAvailable:/ { avail = $2 }
  END {
    used = total - avail
    printf "cpu\t%s\n", cpu
    printf "memory\t%.1fGB / %.0fGB\n", used / 1024 / 1024, total / 1024 / 1024
  }
' /proc/meminfo
