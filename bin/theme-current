#!/bin/bash

# dhms:summary=Print the current theme name in display form (hyphens become spaces, words capitalized)

THEME_NAME_PATH="$HOME/.config/themes/current/theme.name"

if [[ -f $THEME_NAME_PATH ]]; then
  cat $THEME_NAME_PATH | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
else
  echo "Unknown"
fi
