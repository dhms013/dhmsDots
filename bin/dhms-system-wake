#!/bin/bash

# dhms:summary=Wake displays and restore brightness after idle; --resume also re-arms the shell lock after suspend
# dhms:group=system
# dhms:name=wake
# dhms:examples=dhms system wake | dhms system wake --resume (hypridle after_sleep_cmd)

dhms-brightness-display on
dhms-brightness-keyboard restore
dhms-hyprland-monitor-clamshell >/dev/null 2>&1 || true

if [[ "${1:-}" == "--resume" ]]; then
  # A long suspend can take the shell's lock surfaces (and the whole shell)
  # down with it. Bring quickshell back if it died, then make sure a live
  # lock holds whenever the compositor still reports the session locked.
  if ! pgrep -x quickshell >/dev/null 2>&1; then
    restart-quickshell
  fi
  for _ in $(seq 1 20); do
    pgrep -x quickshell >/dev/null 2>&1 && break
    sleep 0.5
  done
  # no-op when the shell already holds the lock; exit 2 (undetermined) is
  # left to the shell's own stranded-lock recovery.
  dhms-hyprland-session-locked && dhms-lock >/dev/null 2>&1 || true
fi
