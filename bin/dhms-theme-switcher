#!/bin/bash

# dhms:summary=Open the theme switcher (image grid, one preview per theme)
# dhms:args=[--refresh-cache]
# dhms:examples=dhms-theme-switcher | theme=$(dhms-theme-switcher) && theme-set "$theme"

refresh_cache=false
case "${1:-}" in
  --refresh-cache)
    refresh_cache=true
    ;;
  --help|-h)
    echo "Usage: dhms-theme-switcher [--refresh-cache]"
    exit 0
    ;;
  "") ;;
  *)
    echo "Usage: dhms-theme-switcher [--refresh-cache]" >&2
    exit 1
    ;;
esac
if (( $# > 1 )); then
  echo "Usage: dhms-theme-switcher [--refresh-cache]" >&2
  exit 1
fi

CACHE_PATH="${XDG_CACHE_HOME:-$HOME/.cache}/dhms/theme-selector"
preview_dir="$CACHE_PATH/previews"
signature_file="$CACHE_PATH/signature"
fast_signature_file="$CACHE_PATH/fast-signature"

THEMES_PATH="$HOME/.config/themes/themeLists"

mkdir -p "$preview_dir"

if [[ $refresh_cache == true ]]; then
  # Keep concurrent installer refreshes from rebuilding links or republishing
  # cached rows over one another. The descriptor stays open through cache warmup.
  exec {refresh_lock_fd}>"$CACHE_PATH/refresh.lock" || exit 1
  flock -w 60 "$refresh_lock_fd" || exit 1
fi

find_preview() {
  local theme_path="$1"
  local preview preview_name

  for preview_name in preview.png preview.jpg preview.jpeg preview.webp preview.gif preview.bmp; do
    preview=$(find -L "$theme_path" -maxdepth 1 -type f -iname "$preview_name" -print -quit 2>/dev/null)

    if [[ -n $preview ]]; then
      printf '%s\n' "$preview"
      return
    fi
  done

  if [[ -d $theme_path/backgrounds ]]; then
    find -L "$theme_path/backgrounds" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \) -print 2>/dev/null | sort | head -n 1
  fi
}

add_theme_preview() {
  local theme_name="$1"
  local preview="$2"
  local extension="${preview##*.}"
  extension="${extension,,}"

  [[ -n $preview ]] || return
  [[ -e $preview_dir/$theme_name.$extension ]] && return

  ln -s "$preview" "$preview_dir/$theme_name.$extension"
}

theme_paths=()
if [[ -d $THEMES_PATH ]]; then
  mapfile -d '' -t theme_paths < <(find -L "$THEMES_PATH" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -print0 2>/dev/null | sort -z)
fi

fast_signature="v1"$'\n'
if [[ -d $THEMES_PATH ]]; then
  fast_signature+="$THEMES_PATH:$(stat -Lc '%Y' "$THEMES_PATH")"$'\n'

  for theme_path in "${theme_paths[@]}"; do
    fast_signature+="$theme_path:$(stat -Lc '%Y' "$theme_path")"$'\n'
  done
fi

if [[ $refresh_cache == true || ! -f $fast_signature_file ]] || ! cmp -s "$fast_signature_file" <(printf '%s' "$fast_signature"); then
  theme_signature=""
  if [[ -d $THEMES_PATH ]]; then
    for theme_path in "${theme_paths[@]}"; do
      preview=$(find_preview "$theme_path")
      theme_signature+="$theme_path:$(stat -Lc '%Y' "$theme_path")"$'\n'

      if [[ -n $preview ]]; then
        theme_signature+="$preview:$(stat -Lc '%s:%Y' "$preview")"$'\n'
      fi
    done
  fi

  rm -rf "$preview_dir"
  mkdir -p "$preview_dir"

  for theme_path in "${theme_paths[@]}"; do
    theme_name=${theme_path##*/}
    preview=$(find_preview "$theme_path")
    add_theme_preview "$theme_name" "$preview"
  done

  printf '%s' "$theme_signature" >"$signature_file"
  printf '%s' "$fast_signature" >"$fast_signature_file"
fi

if [[ $refresh_cache == true ]]; then
  # An installed replacement can retain the old size and timestamps. Invalidate
  # this directory's rows and thumbnails explicitly before warming the picker.
  image_cache="${XDG_CACHE_HOME:-$HOME/.cache}/dhms/image-selector"
  cache_key=$(printf '%s' "$preview_dir" | md5sum | cut -d ' ' -f 1)
  declare -A invalidated_hashes=()
  if [[ -f $image_cache/index.tsv ]]; then
    while IFS=$'\t' read -r image _signature hash; do
      if [[ $image == "$preview_dir/"* && $hash =~ ^[[:xdigit:]]{32}$ && -z ${invalidated_hashes[$hash]:-} ]]; then
        # A lazy thumbnail producer may still be publishing the old image.
        # Wait on its own lock, then remove the completed result.
        exec {thumbnail_lock_fd}>"$image_cache/$hash.jpg.lock" || exit 1
        flock -w 60 "$thumbnail_lock_fd" || exit 1
        rm -f "$image_cache/$hash.jpg"
        exec {thumbnail_lock_fd}>&-
        invalidated_hashes[$hash]=true
      fi
    done <"$image_cache/index.tsv"
  fi
  if [[ -d $image_cache ]]; then
    exec {rows_lock_fd}>"$image_cache/$cache_key.rows.lock" || exit 1
    flock -w 30 "$rows_lock_fd" || exit 1
    rm -f "$image_cache/$cache_key.rows" "$image_cache/$cache_key.signature" "$image_cache/$cache_key.fast-signature"
    exec {rows_lock_fd}>&-
  fi
  exec dhms-menu-images --cache-only "$preview_dir"
fi

current_theme=$(cat "$HOME/.config/themes/current/theme.name" 2>/dev/null)
selected_preview=""
for extension in png jpg jpeg webp gif bmp; do
  if [[ -e $preview_dir/$current_theme.$extension ]]; then
    selected_preview="$preview_dir/$current_theme.$extension"
    break
  fi
done

menu_args=(
  --print-name
  --show-labels
  --filterable
  --lazy-thumbnails
  --preview-mode theme
  --selected "$selected_preview"
)

exec dhms-menu-images "${menu_args[@]}" "$preview_dir"
