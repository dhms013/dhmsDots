#!/bin/bash

# Sets the specified image as the current background

if [[ -z "$1" ]]; then
  echo "Usage: background-set <path-to-image>" >&2
  exit 1
fi

BACKGROUND="$(realpath -- "$1")" || exit 1
CURRENT_BACKGROUND_LINK="$HOME/.config/themes/current/background"

if [[ ! -f $BACKGROUND ]]; then
  echo "File does not exist: $BACKGROUND" >&2
  exit 1
fi

# Create symlink to the new background
ln -nsf "$BACKGROUND" "$CURRENT_BACKGROUND_LINK"

# Update the live shell immediately when running; the shell also watches the
# symlink, so this is belt-and-suspenders (and silent when no shell is up).
dhms-shell -q background set "$BACKGROUND"
