#!/bin/bash

USER_TEMPLATES_DIR="$HOME/.config/themes/themed"
NEXT_THEME_PATH="$HOME/.config/themes/current/next-theme"
COLORS_FILE="$NEXT_THEME_PATH/colors.toml"

CURRENT_THEME_PATH="$HOME/.config/themes/current/theme"
NEXT_THEME_PATH="$HOME/.config/themes/current/next-theme"
USER_THEMES_PATH="$HOME/.config/themes/themeLists/"
BG_DIR="$HOME/.config/themes/current/theme/backgrounds/"
LINKED_BG="$HOME/.config/themes/current/background"

# Convert hex color to decimal RGB (e.g., "#1e1e2e" -> "30,30,46")
hex_to_rgb() {
  local hex="${1#\#}"
  printf "%d,%d,%d" "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

set_template() {
  # Only generate dynamic templates for themes with a colors.toml definition
  if [[ -f $COLORS_FILE ]]; then
    sed_script=$(mktemp)

    while IFS='=' read -r key value; do
      key="${key//[\"\' ]/}"                # strip quotes and spaces from key
      [[ $key && $key != \#* ]] || continue # skip empty lines and comments
      value="${value#*[\"\']}"
      value="${value%%[\"\']*}" # extract value between quotes (ignores inline comments)

      printf 's|{{ %s }}|%s|g\n' "$key" "$value"            # {{ key }} -> value
      printf 's|{{ %s_strip }}|%s|g\n' "$key" "${value#\#}" # {{ key_strip }} -> value without leading #
      if [[ $value =~ ^# ]]; then
        rgb=$(hex_to_rgb "$value")
        echo "s|{{ ${key}_rgb }}|${rgb}|g"
      fi
    done <"$COLORS_FILE" >"$sed_script"

    shopt -s nullglob

    # Process user templates first, then built-in templates (user overrides built-in)
    for tpl in "$USER_TEMPLATES_DIR"/*.tpl; do
      filename=$(basename "$tpl" .tpl)
      output_path="$NEXT_THEME_PATH/$filename"

      # Don't overwrite configs already exists in the output directory (copied from theme specific folder)
      if [[ ! -f $output_path ]]; then
        sed -f "$sed_script" "$tpl" >"$output_path"
      fi
    done

    rm "$sed_script"
  fi
}

set_theme() {
  if [[ -d "$USER_THEMES_PATH/$THEME_NAME" ]]; then
    THEME_PATH="$USER_THEMES_PATH/$THEME_NAME"
  else
    echo "Theme '$THEME_NAME' does not exist"
    notify-send "Theme not found" "'$THEME_NAME' does not exist in ~/.config/themes/themeLists"
    exit 1
  fi

  # Setup clean next theme directory (for atomic theme config swapping)
  rm -rf "$NEXT_THEME_PATH"
  mkdir -p "$NEXT_THEME_PATH"

  # Copy static configs
  cp -r "$THEME_PATH/"* "$NEXT_THEME_PATH/" 2>/dev/null

  # Generate dynamic configs
  set_template

  # Swap next theme in as current
  rm -rf "$CURRENT_THEME_PATH"
  mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

  # Store theme name for reference
  echo "$THEME_NAME" >"$HOME/.config/themes/current/theme.name"
}

# Change background with theme
set_background() {
  local bg_target
  bg_target="$(find "$BG_DIR" -type f | sort | head -n 1)"
  [[ -n $bg_target ]] || return 0

  # Point the symlink at the resolved image, then push the RESOLVED path over
  # IPC. Pushing the symlink path itself would string-match as "unchanged" on
  # every switch after the first and leave only the ~1s watcher to repaint.
  ln -nsf "$bg_target" "$LINKED_BG"
  dhms-shell -q background set "$bg_target"
}

# Re-theme the running shell (bar, menus, popups) without a restart. Mirrors
# omarchy-theme-set: base64 the theme's colors.toml and generated shell.toml
# and hand them to `shell applyTheme`. Empty payloads are fine — applyTheme
# treats them as "keep current".
push_shell_theme() {
  local colors_b64="" shell_b64=""
  [[ -f $CURRENT_THEME_PATH/colors.toml ]] && colors_b64=$(base64 -w 0 "$CURRENT_THEME_PATH/colors.toml")
  [[ -f $CURRENT_THEME_PATH/shell.toml ]] && shell_b64=$(base64 -w 0 "$CURRENT_THEME_PATH/shell.toml")
  dhms-shell shell applyTheme "$colors_b64" "$shell_b64" >/dev/null 2>&1 || true
}

set_theme
set_background
push_shell_theme
