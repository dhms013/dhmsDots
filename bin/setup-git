#!/bin/bash

set -euo pipefail

# ── Input ─────────────────────────────────────────────────────
input() {
  read -p "Name  : " name
  read -p "Email : " email
}

# ── Git global config ─────────────────────────────────────────
config() {
  git config --global user.name "$name"
  git config --global user.email "$email"
}

# ── Generate SSH key ──────────────────────────────────────────
generate_key() {
  ssh-keygen -t ed25519 -C "$email" -f ~/.ssh/id_ed25519
}

# ── Add to ssh-agent ──────────────────────────────────────────
add_agent() {
  eval "$(ssh-agent -s)"
  ssh-add ~/.ssh/id_ed25519
}

# ── Print public key ──────────────────────────────────────────
print_key() {
  echo ""
  echo "Add this public key to GitHub/GitLab:"
  echo "──────────────────────────────────────"
  cat ~/.ssh/id_ed25519.pub
}

# ── Test Connection ───────────────────────────────────────────
test_connection() {
  echo ""
  frames=('Ω' 'Ο' 'Ø' 'Π' 'Δ' 'Σ' 'Ζ' 'Θ' 'Ξ' 'Ψ') # globe-style braille spinner
  (
    trap 'exit' TERM
    i=0
    while :; do
      printf '\r%s Press any key after public key added to GitHub/GitLab... ' "${frames[$((i % ${#frames[@]}))]}"
      i=$((i + 1))
      sleep 0.08
    done
  ) &
  spinner_pid=$!
  if [ -t 0 ]; then read -n 1 -s; else read -n 1 -s </dev/tty; fi || true
  kill "$spinner_pid" 2>/dev/null || true
  wait "$spinner_pid" 2>/dev/null || true
  printf '\r%*s\r' 70 ''
  ssh -T git@github.com
}

# ── Main ──────────────────────────────────────────────────────
main() {
  input
  config
  generate_key
  add_agent
  print_key
  test_connection
}

main
