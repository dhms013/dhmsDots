#!/bin/bash

# dhms:summary=Start or stop hypridle idle-locking

if pgrep -x hypridle >/dev/null; then
  pkill -x hypridle
  notify-send -u low "󱫖   Stay Awake" "Stop locking/suspend computer when idle"
else
  uwsm-app -- hypridle >/dev/null 2>&1 &
  notify-send -u low "󱫖   Allow Idle Lock" "Start locking/suspend computer when idle"
fi
