#!/bin/bash

# dhms:summary=Stage the prebuilt Arch Linux VM image and its guest setup scripts
# dhms:hidden=true
# dhms:group=vm

# Engine for `dhms-vm install arch`. The Arch VM boots a prebuilt cloud image
# (Arch-Linux-x86_64-basic.qcow2) directly instead of a live installer ISO, so
# the user's chosen account is provisioned in-guest later via setup-arch.sh
# (reached through the /shared 9p mount). This script:
#
#  1. Backs up and clears stale VM artifacts under <storage>/arch so a rerun can
#     never destroy the previous boot image (all backups are timestamped).
#  2. Downloads the verified prebuilt image to <storage>/arch/boot.qcow2. dockur
#     finds it through its namespaced findBootFile() and boots it directly; if
#     both mirrors fail, the partial file is removed and the compose keeps
#     BOOT=arch so dockur performs the same download itself at container start.
#  3. Writes the in-guest provisioning files into <shared> (the /shared 9p
#     mount): config.json (informational), setup-arch.env (sourced by the guest
#     script, values %q-shell-quoted so the password survives any character),
#     and setup-arch.sh (the provisioner the user runs inside the guest).

# Reads positional args in one fixed order, no arbitrary shell input is taken.
#   dhms-vm-arch-prepare <storage> <shared> <username> <password> <hostname> <profile> <timezone>

ARCH_BASE_URL="https://geo.mirror.pkgbuild.com/images/latest/Arch-Linux-x86_64-basic.qcow2"
ARCH_MIRROR_URL="https://repo.huaweicloud.com/archlinux/images/latest/Arch-Linux-x86_64-basic.qcow2"
ARCH_EXPECTED_BYTES=519176192

fail() {
  echo "dhms-vm-arch-prepare: $*" >&2
  exit 1
}

usage() {
  echo "Usage: $0 <storage> <shared> <username> <password> <hostname> <profile> <timezone>" >&2
  exit 2
}

(($# == 7)) || usage

storage="$1"
shared="$2"
username="$3"
password="$4"
hostname="$5"
profile="$6"
tz="$7"

case "$profile" in
hyprland | kde | gnome | minimal) ;;
*) fail "unknown profile: $profile (expect hyprland|kde|gnome|minimal)" ;;
esac

archdir="$storage/arch"
mkdir -p "$archdir" "$shared" || fail "could not create $archdir or $shared"

# --- 1. Back up and clear stale artifacts ------------------------------------

# One timestamp per prepare run keeps reruns identifiable without collisions.
echo "==> Refreshing $archdir (stale artifacts are backed up, never deleted)"
local_ts=""
for artifact in boot.qcow2 data.img qemu.mac uefi.rom uefi.vars; do
  if [[ -e $archdir/$artifact ]]; then
    [[ -n $local_ts ]] || local_ts="$(date +%Y%m%d-%H%M%S)"
    mv -f "$archdir/$artifact" "$archdir/$artifact.bak.$local_ts" \
      2>/dev/null || rm -f "$archdir/$artifact"
    echo "   moved stale artifact -> $artifact.bak.$local_ts"
  fi
done

# --- 2. Download the prebuilt image ------------------------------------------

verify_image() {
  local file="$1" size magic
  [[ -f $file ]] || return 1
  size=$(stat -c%s "$file" 2>/dev/null) || return 1
  ((size == ARCH_EXPECTED_BYTES)) || return 1
  magic=$(head -c 4 "$file" 2>/dev/null | od -An -tx1 | tr -d ' \n')
  [[ $magic == "514649fb" ]] || return 1
  return 0
}

download_try() {
  local url="$1" tmp="$2" base
  base=$(basename "$url")
  echo "   downloading $base"
  curl --fail --location --retry 3 --connect-timeout 15 \
    --output "$tmp" "$url" || return 1
  verify_image "$tmp"
}

download_image() {
  local dest="$archdir/boot.qcow2" tmp="$archdir/.boot.qcow2.part"
  [[ -e $dest ]] && return 0

  rm -f "$tmp"
  touch "$tmp" 2>/dev/null || true
  { chattr +C "$tmp" 2>/dev/null || true; } # keep dockur's NOCOW convention

  if download_try "$ARCH_BASE_URL" "$tmp"; then
    mv -f "$tmp" "$dest" || { rm -f "$tmp"; fail "could not publish $dest"; }
    echo "   prebuilt Arch image staged: $dest ($(du -h "$dest" | cut -f1))"
    return 0
  fi

  if download_try "$ARCH_MIRROR_URL" "$tmp"; then
    mv -f "$tmp" "$dest" || { rm -f "$tmp"; fail "could not publish $dest"; }
    echo "   prebuilt Arch image staged (mirror): $dest ($(du -h "$dest" | cut -f1))"
    return 0
  fi

  rm -f "$tmp"
  echo "   WARNING: could not download the prebuilt Arch image from either mirror."
  echo "            Falling back to dockur's own BOOT=arch download at container start."
  return 0
}

download_image

# --- 3. Stage the guest provisioning files ------------------------------------

if ! command -v jq >/dev/null 2>&1; then
  fail "jq is required to write $shared/config.json"
fi

jq -n --arg u "$username" --arg p "$password" --arg h "$hostname" \
  --arg pr "$profile" --arg t "$tz" \
  '{username:$u,password:$p,hostname:$h,profile:$pr,tz:$t}' >"$shared/config.json" \
  || fail "could not write $shared/config.json"
chmod 600 "$shared/config.json" 2>/dev/null || true

{
  printf 'USERNAME=%q\n' "$username"
  printf 'PASSWORD=%q\n' "$password"
  printf 'HOSTNAME=%q\n' "$hostname"
  printf 'PROFILE=%q\n' "$profile"
  printf 'TZ=%q\n' "$tz"
} >"$shared/setup-arch.env" || fail "could not write $shared/setup-arch.env"
chmod 600 "$shared/setup-arch.env" 2>/dev/null || true

cat >"$shared/setup-arch.sh" <<'EOSCRIPT'
#!/bin/bash
set -euo pipefail

# In-guest provisioner for the dhms Arch VM (prebuilt cloud image).
#
# Run these commands inside the guest (web viewer at :8016, or SSH/console
# as the prebuilt image's default user):
#
#   sudo mkdir -p /mnt/shared
#   sudo mount -t 9p -o trans=virtio shared /mnt/shared
#   sudo bash /mnt/shared/setup-arch.sh
#
# The prebuilt Arch basic image already boots and logs in with user "arch" /
# password "arch". This script applies the chosen user profile, the profile's
# package set, and arms sshd + the display manager. It is idempotent-ish; each
# package install runs with --needed.

envfile="/mnt/shared/setup-arch.env"
[[ -f $envfile ]] || {
  echo "setup-arch.env not found on /mnt/shared — mount the 9p share first:" >&2
  echo "  sudo mkdir -p /mnt/shared && sudo mount -t 9p -o trans=virtio shared /mnt/shared" >&2
  exit 1
}
# shellcheck source=/dev/null
. "$envfile"

if [[ $EUID -ne 0 ]]; then
  echo "run as root:  sudo bash /mnt/shared/setup-arch.sh" >&2
  exit 1
fi

[[ -n ${USERNAME:-} && -n ${HOSTNAME:-} && -n ${PROFILE:-} && -n ${TZ:-} ]] || {
  echo "corrupt setup-arch.env (missing fields)" >&2
  exit 1
}

echo "==> pacman -Syu --needed"
pacman -Syu --noconfirm --needed

echo "==> creating user $USERNAME (wheel)"
id "$USERNAME" >/dev/null 2>&1 || useradd -m -G wheel -s /bin/bash "$USERNAME"
echo "$USERNAME:$PASSWORD" | chpasswd

echo "==> enabling sudo for wheel"
mkdir -p /etc/sudoers.d
printf '%%wheel ALL=(ALL:ALL) ALL\n' >"/etc/sudoers.d/10-dhms-${USERNAME}"
chmod 0440 "/etc/sudoers.d/10-dhms-${USERNAME}"

echo "==> setting hostname $HOSTNAME"
hostnamectl set-hostname "$HOSTNAME" 2>/dev/null \
  || echo "$HOSTNAME" >/etc/hostname

echo "==> setting timezone $TZ"
timedatectl set-timezone "$TZ" 2>/dev/null || true

echo "==> enabling sshd + NetworkManager"
systemctl enable --now sshd NetworkManager 2>/dev/null || true

declare -a pkgs=()
case "$PROFILE" in
minimal) pkgs=() ;;
hyprland) pkgs=(hyprland waybar greetd greetd-tuigreet kitty) ;;
kde) pkgs=(plasma-meta sddm konsole) ;;
gnome) pkgs=(gnome gdm) ;;
*) echo "unknown profile: $PROFILE" >&2; exit 1 ;;
esac

if ((${#pkgs[@]})); then
  echo "==> installing $PROFILE profile: ${pkgs[*]}"
  pacman -S --noconfirm --needed "${pkgs[@]}"
fi

case "$PROFILE" in
kde) systemctl enable --now sddm 2>/dev/null || true ;;
gnome) systemctl enable --now gdm 2>/dev/null || true ;;
hyprland) systemctl enable --now greetd 2>/dev/null || true ;;
esac

echo ""
  echo "Provisioning complete. Reboot the guest, then log in as: $USERNAME"
  echo "(web viewer: http://127.0.0.1:8016 while the VM runs)"

  # Marker for the host's `dhms vm status`: the 9p shared dir is the host's
  # ~/Arch, so this file is visible there once the guest writes it.
  echo "$USERNAME" >"/mnt/shared/.provisioned-${USERNAME}" 2>/dev/null || true
EOSCRIPT
chmod 700 "$shared/setup-arch.sh" 2>/dev/null || true

echo "==> Guest provisioning staged in $shared:"
echo "   config.json      (settings, informational)"
echo "   setup-arch.env   (sourced values, mode 0600)"
echo "   setup-arch.sh    (run this inside the guest as root)"
echo ""
echo "In the guest (as the image's arch/arch login):"
echo "  sudo mkdir -p /mnt/shared"
echo "  sudo mount -t 9p -o trans=virtio shared /mnt/shared"
echo "  sudo bash /mnt/shared/setup-arch.sh"