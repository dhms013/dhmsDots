#!/bin/bash

# dhms:summary=Disable a shell plugin
# dhms:group=plugin
# dhms:args=<id>

set -euo pipefail

fail() {
  echo "dhms-plugin-disable: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: dhms plugin disable <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"

result=$(dhms-shell shell setPluginEnabled "$id" false)
[[ $result == "ok" ]] ||
  fail "plugin '$id' is not known; run: dhms-shell shell rescanPlugins"

echo "Disabled $id"
