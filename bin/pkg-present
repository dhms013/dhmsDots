#!/bin/bash

# dhms:summary=Exit 0 if all of the named packages are installed on the system, 1 if any are missing
# dhms:args=<packages...>

# Returns true if all the commands passed in as arguments exit on the system.

for pkg in "$@"; do
  pacman -Q "$pkg" &>/dev/null || exit 1
  gum log --level info "$pkg is present"
done

exit 0
