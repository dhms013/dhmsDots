#!/bin/bash

export PATH="$HOME/.dhmsDots/bin:$PATH"

# Set to true when going directly to a submenu, so we can exit directly
BACK_TO_EXIT=false

back_to() {
  local parent_menu="$1"

  if [[ "$BACK_TO_EXIT" == "true" ]]; then
    exit 0
  elif [[ -n "$parent_menu" ]]; then
    "$parent_menu"
  else
    show_main_menu
  fi
}

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n "$preselect" ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n "$index" ]]; then
      args+=("-c" "$index")
    fi
  fi

  echo -e "$options" | rofi -dmenu \
    -theme ~/.config/rofi/themes/theme.rasi \
    -theme-str 'window { width: 230px; height: 300px;} listview { lines: 5;}' \
    -p "$prompt…" "${args[@]}" 2>/dev/null
}

present_terminal() {
  floating-terminal $1
}

screenrecord_menu() {
  screenrecord --stop-recording && exit 0

  selected=$(printf "  Without audio\n  With desktop audio\n  With desktop + microphone audio" | rofi -dmenu \
    -i \
    -theme-str 'window {width: 350px; height: 200px;}')

  case "$selected" in
  *"Without audio") screenrecord ;;
  *"With desktop audio") screenrecord --with-desktop-audio ;;
  *"With desktop + microphone audio") screenrecord --with-desktop-audio --with-microphone-audio ;;
  *) back_to main-menu ;;
  esac
}

install_menu() {
  local action="$1"

  if [[ -z "$action" ]]; then
    action=$(menu "Install" "󰣇  Pacman\n󰣇  AUR\n󰸌  Themes")
  fi

  case "$action" in
  *Pacman*) present_terminal pkg-install ;;
  *AUR*) present_terminal pkg-aur-install ;;
  *Themes*) present_terminal theme-install ;;
  *) setup_menu ;;
  esac
}
setup_menu() {
  local action="$1"
  local options="  Background\n󰱔  DNS\n󰉉  Install\n󱐋  Power Profile\n󰭌  Remove\n󰸌  Themes\n  Security"

  if [[ -z "$action" ]]; then
    action=$(menu "Setup" "$options")
  fi

  case "$action" in
  *Background*) background-selector ;;
  *DNS*) present_terminal setup-dns ;;
  *Install*) install_menu ;;
  *Power*) setup_power_menu ;;
  *Remove*) present_terminal pkg-remove ;;
  *Theme*) theme-selector ;;
  *Security*) security_menu ;;
  *) main_menu ;;
  esac
}

setup_power_menu() {
  profile=$(menu "Power Profile" "$(powerprofiles-list)" "" "$(powerprofilesctl get)")

  if [[ "$profile" == "CNCLD" || -z "$profile" ]]; then
    back_to setup_menu
  else
    powerprofilesctl set "$profile"
  fi
}

security_menu() {
  local action="$1"

  if [[ -z "$action" ]]; then
    action=$(menu "Setup" "󰈷  Fingerprint\n  Fido2")
  fi

  case "$action" in
  *Fingerprint*) present_terminal setup-fingerprint ;;
  *Fido2*) present_terminal setup-fido2 ;;
  *) setup_menu ;;
  esac
}

system_menu() {
  local action="$1"

  if [[ -z "$action" ]]; then
    action=$(menu "System" "󰒲  Suspend\n  Lock\n󰍃  Logout\n󰜉  Reboot\n󰐥  Shutdown")
  fi

  case "$action" in
  *Suspend*) systemctl suspend ;;
  *Lock*) pkill hyprlock && pidof hyprlock || hyprlock & ;;
  *Logout*) uwsm stop ;;
  *Reboot*) systemctl reboot --no-wall ;;
  *Shutdown*) systemctl poweroff ;;
  *) back_to main_menu ;;
  esac
}

main_menu() {
  go_to_menu "$(menu "Go" "  Update\n  Setup\n  System")"
}

go_to_menu() {
  case "${1,,}" in
  *aur*) install_menu AUR ;;
  *background*) setup_menu Background ;;
  *dhms*) present_terminal dhms-update ;;
  *dns*) present_terminal setup-dns ;;
  *fido2*) security_menu Fido2 ;;
  *fingerprint*) security_menu Fingerprint ;;
  *install*) install_menu ;;
  *lock*) system_menu Lock ;;
  *logout*) system_menu Logout ;;
  *pacman*) install_menu Pacman ;;
  *power*) setup_power_menu ;;
  *reboot*) system_menu Reboot ;;
  *remove*) setup_menu Remove ;;
  *screenrecord*) screenrecord_menu ;;
  *security*) security_menu ;;
  *setup*) setup_menu ;;
  *shutdown*) system_menu Shutdown ;;
  *suspend*) system_menu Suspend ;;
  *system*) system_menu ;;
  *themes*) setup_menu Theme ;;
  *update*) present_terminal pkg-update ;;
  esac
}
if [[ -n "$1" ]]; then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  main_menu
fi
