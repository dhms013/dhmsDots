#!/bin/bash
sudo modprobe -r iwlmvm iwlwifi && sudo modprobe iwlwifi

sleep 5

IFACE=$(ip link | grep -o 'wlan[0-9]*' | head -1)
[ -z "$IFACE" ] && {
  echo "No wireless interface found"
  exit 1
}

sudo networkctl renew "$IFACE"

sleep 3
ping -c1 -W1 8.8.8.8 &>/dev/null && echo "Connected." || echo "Still no traffic."
